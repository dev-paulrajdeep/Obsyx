/**
 * Obsyx - Central Rofi Configuration
 * Noctis Amethyst desktop application launcher & menus.
 */

configuration {
    modi:                       "drun,run,filebrowser,window,calc,emoji";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    display-calc:               "";
    display-emoji:              "󰞅";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

@theme "theme.rasi"
