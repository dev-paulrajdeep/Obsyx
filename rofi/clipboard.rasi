/**
 * Obsyx - Noctis Amethyst Clipboard Manager Theme
 */

@import "generated/theme-tokens.rasi"

* {
    background-color:            transparent;
    text-color:                  @ink-default;
    font:                        "JetBrainsMono Nerd Font 10";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       700px;
    border:                      @border-width;
    border-radius:               @rounding;
    border-color:                @hairline-strong;
    background-color:            @noctis-surface-raised;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     24px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px 14px;
    border:                      1px solid;
    border-radius:               @rounding;
    border-color:                @hairline;
    background-color:            @noctis-surface;
    text-color:                  @ink-strong;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @amethyst;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @ink-strong;
    cursor:                      text;
    placeholder:                 "Search clipboard...";
    placeholder-color:           @ink-quiet;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     6px;
    background-color:            transparent;
}

element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 12px;
    border:                      1px solid;
    border-radius:               @rounding;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @ink-default;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @ink-default;
}

element selected.normal {
    border-color:                @amethyst-line;
    background-color:            @amethyst-fill;
    text-color:                  @amethyst-ink;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
