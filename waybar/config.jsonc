{
    //──────────────────────────────────────────────
    // Obsyx Waybar — Noctis Amethyst
    //──────────────────────────────────────────────
    //
    // Product hierarchy:
    // navigation and current context → time → contextual media and system state.
    // Groups represent relationships, not merely visual decoration.

    "layer": "top",
    "position": "top",

    "height": 40,
    "spacing": 8,

    "margin-top": 12,
    "margin-left": 12,
    "margin-right": 12,

    "exclusive": true,
    "passthrough": false,

    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    //──────────────────────────────────────────────
    // Left — navigation and current context
    //──────────────────────────────────────────────

    "modules-left": [
        "group/launcher",
        "group/workspaces",
        "hyprland/window"
    ],

    "group/launcher": {
        "orientation": "horizontal",
        "modules": ["custom/launcher"]
    },

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces"]
    },

    //──────────────────────────────────────────────
    // Center — time anchor
    //──────────────────────────────────────────────

    "modules-center": [
        "group/clock"
    ],

    "group/clock": {
        "orientation": "horizontal",
        "modules": ["clock"]
    },

    //──────────────────────────────────────────────
    // Right — contextual media, system instrument cluster, session controls

    "modules-right": [
        "custom/media",

        "group/system",

        "custom/notifications",

        "group/tray-expander",

        "group/power"
    ],

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/cpu",
            "custom/memory",
            "custom/gpu",
            "custom/network",
            "custom/vpn",
            "pulseaudio",
            "bluetooth",
            "battery"
        ]
    },

    "group/power": {
        "orientation": "horizontal",
        "modules": ["custom/power"]
    },

    //──────────────────────────────────────────────
    // Include modules
    //──────────────────────────────────────────────

    "include": [
        "modules/launcher.jsonc",

        "modules/workspaces.jsonc",
        "modules/window.jsonc",

        "modules/clock.jsonc",

        "modules/media.jsonc",

        "modules/cpu.jsonc",
        "modules/memory.jsonc",
        "modules/gpu.jsonc",

        "modules/network.jsonc",
        "modules/vpn.jsonc",

        "modules/audio.jsonc",
        "modules/bluetooth.jsonc",

        "modules/battery.jsonc",

        "modules/notifications.jsonc",

        "modules/tray.jsonc",

        "modules/power.jsonc"
    ]
}
