{
    "custom/vpn": {
        "exec": "sh -c 'for d in \"$WAYBAR_SCRIPTS_DIR\" ./scripts ./waybar/scripts \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts\"; do [ -n \"$d\" ] && [ -x \"$d/vpninfo.sh\" ] && exec \"$d/vpninfo.sh\" \"$@\"; done'",
        "return-type": "json",

        "interval": 5,

        "format": "{}",

        "tooltip": true,
        "escape": true,

        "on-click": "nm-connection-editor",
        "on-click-middle": "kitty -e nmcli connection show --active",
        "on-click-right": "kitty -e journalctl -u NetworkManager -f"
    }
}
