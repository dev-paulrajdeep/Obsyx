{
    "custom/memory": {
        "exec": "sh -c 'for d in \"$WAYBAR_SCRIPTS_DIR\" ./scripts ./waybar/scripts \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts\"; do [ -n \"$d\" ] && [ -x \"$d/memoryinfo.sh\" ] && exec \"$d/memoryinfo.sh\" \"$@\"; done'",
        "return-type": "json",

        "interval": 2,

        "format": "{}",

        "tooltip": true,
        "escape": true,

        "on-click": "kitty -e btop",
        "on-click-middle": "kitty -e htop",
        "on-click-right": "kitty -e free -h; bash"
    }
}
