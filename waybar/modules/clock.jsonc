{
    "clock": {
        "interval": 1,

        "format": "󰥔 {:%a %d %b  •  %H:%M}",

        "tooltip": true,
        "tooltip-format": "<big><b>{:%A, %d %B %Y}</b></big>\n\n<tt>{calendar}</tt>",

        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",

            // Semantic formatting: inherits typography and color hierarchy
            // from tooltip design tokens (@ink-strong, @ink-default).
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<b>{}</b>",
                "today": "<b><u>{}</u></b>"
            }
        },

        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
