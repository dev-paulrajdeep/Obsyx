{
    "custom/network": {
        "exec": "sh -c 'for d in \"$WAYBAR_SCRIPTS_DIR\" ./scripts ./waybar/scripts \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts\"; do [ -n \"$d\" ] && [ -x \"$d/networkinfo.sh\" ] && exec \"$d/networkinfo.sh\" \"$@\"; done'",
        "return-type": "json",

        "interval": 2,

        "format": "{}",

        "tooltip": true,
        "escape": true,

        "on-click": "nm-connection-editor",
        "on-click-middle": "kitty -e nmtui",
        "on-click-right": "kitty -e nmcli device status"
    }
}
