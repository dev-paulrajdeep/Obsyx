{
    "custom/gpu": {
        "exec": "sh -c 'for d in \"$WAYBAR_SCRIPTS_DIR\" ./scripts ./waybar/scripts \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts\"; do [ -n \"$d\" ] && [ -x \"$d/gpuinfo.sh\" ] && exec \"$d/gpuinfo.sh\" \"$@\"; done'",
        "return-type": "json",

        "interval": 2,

        "format": "{}",

        // Same escape fix as cpu.jsonc — protects against unescaped markup
        // characters in driver/process strings from the GPU script output.
        "escape": true,

        "tooltip": true,

        "on-click": "kitty -e nvtop",
        "on-click-middle": "kitty -e btop",
        "on-click-right": "nvidia-settings"
    }
}
