#!/usr/bin/env python3
"""Obsyx CLI Core & Diagnostic Validator.

Usage:
    obsyx --version
    obsyx --help
    obsyx doctor [--json] [--verbose]
    obsyx validate [--path PATH] [--json] [--verbose]
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

VERSION = "0.1.0"

# ANSI Terminal Colors
USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text

def bold(text: str) -> str: return _c("1", text)
def green(text: str) -> str: return _c("32", text)
def yellow(text: str) -> str: return _c("33", text)
def red(text: str) -> str: return _c("31", text)
def cyan(text: str) -> str: return _c("36", text)
def dim(text: str) -> str: return _c("2", text)


def _strip_jsonc_comments(text: str) -> str:
    """Remove single-line (//) and multi-line (/* */) comments from JSONC text."""
    pattern = re.compile(
        r'//.*?$|/\*.*?\*/|"(?:\\.|[^\\"])*"',
        re.DOTALL | re.MULTILINE,
    )
    def replacer(match):
        s = match.group(0)
        return ' ' if s.startswith('/') else s
    return re.sub(pattern, replacer, text)


# ---------------------------------------------------------------------------
# Doctor Command
# ---------------------------------------------------------------------------

def run_doctor(args) -> int:
    """Check system dependencies and desktop runtime tooling."""
    checks = []

    # Category definitions
    required_bins = [
        ("Hyprland", ["hyprland", "Hyprland"], "Compositor binary"),
        ("Waybar", ["waybar"], "Status bar"),
        ("Bash", ["bash"], "Shell interpreter"),
        ("Python3", ["python3"], "CLI and compiler runtime"),
        ("Lua", ["lua"], "Configuration runtime"),
        ("Luac", ["luac"], "Lua syntax compiler"),
    ]

    recommended_bins = [
        ("SwayNC", ["swaync", "swaync-client"], "Notification daemon & control center"),
        ("Hyprlock", ["hyprlock"], "Screen locker"),
        ("Rofi", ["rofi"], "Application launcher & menu modal"),
        ("Wlogout", ["wlogout"], "Session & power menu overlay"),
        ("Wallpaper Daemon", ["swww", "swww-daemon", "hyprpaper"], "Wallpaper renderer daemon"),
        ("Kitty", ["kitty"], "Terminal emulator"),
        ("wl-copy", ["wl-copy"], "Wayland clipboard utility"),
        ("cliphist", ["cliphist"], "Clipboard history daemon"),
        ("Polkit Agent", [
            "/usr/lib/hyprpolkitagent/hyprpolkitagent",
            "/usr/libexec/hyprpolkitagent",
            "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1",
            "/usr/libexec/polkit-gnome-authentication-agent-1",
            "/usr/lib/polkit-kde-authentication-agent-1",
            "hyprpolkitagent",
            "lxpolkit",
        ], "Privilege escalation authentication agent"),
    ]

    optional_bins = [
        ("playerctl", ["playerctl"], "MPRIS media player controls"),
        ("brightnessctl", ["brightnessctl"], "Display backlight controls"),
        ("hyprshot", ["hyprshot"], "Screenshot utility"),
        ("hyprpicker", ["hyprpicker"], "Screen color picker"),
        ("Network Applet", ["nm-applet"], "NetworkManager tray indicator"),
        ("Bluetooth Applet", ["blueman-applet"], "Bluetooth tray indicator"),
        ("ImageMagick", ["magick", "convert"], "Asset rasterizer"),
    ]

    def _evaluate(name: str, candidates: list, desc: str, category: str):
        found_path = None
        for cand in candidates:
            if cand.startswith("/"):
                if os.path.isfile(cand) and os.access(cand, os.X_OK):
                    found_path = cand
                    break
            else:
                p = shutil.which(cand)
                if p:
                    found_path = p
                    break
        checks.append({
            "name": name,
            "category": category,
            "description": desc,
            "found": found_path is not None,
            "path": found_path,
        })

    for name, cands, desc in required_bins:
        _evaluate(name, cands, desc, "required")

    for name, cands, desc in recommended_bins:
        _evaluate(name, cands, desc, "recommended")

    for name, cands, desc in optional_bins:
        _evaluate(name, cands, desc, "optional")

    req_failed = [c for c in checks if c["category"] == "required" and not c["found"]]
    rec_failed = [c for c in checks if c["category"] == "recommended" and not c["found"]]
    opt_failed = [c for c in checks if c["category"] == "optional" and not c["found"]]

    all_req_ok = len(req_failed) == 0
    status_str = "ok" if all_req_ok and len(rec_failed) == 0 else ("warning" if all_req_ok else "error")

    if getattr(args, "json", False):
        output = {
            "status": status_str,
            "summary": {
                "total": len(checks),
                "required_total": len(required_bins),
                "required_missing": len(req_failed),
                "recommended_total": len(recommended_bins),
                "recommended_missing": len(rec_failed),
                "optional_total": len(optional_bins),
                "optional_missing": len(opt_failed),
            },
            "checks": checks,
        }
        print(json.dumps(output, indent=2))
        return 0 if all_req_ok else 1

    # Human-readable output
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│               Obsyx Doctor Diagnostic Check              │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))

    for cat, title, badge in [
        ("required", "Required Core Tooling", "REQUIRED"),
        ("recommended", "Recommended Desktop Components", "RECOMMENDED"),
        ("optional", "Optional Utilities & Applets", "OPTIONAL"),
    ]:
        print(bold(f"► {title}"))
        for c in checks:
            if c["category"] != cat:
                continue
            if c["found"]:
                status = green("✔ FOUND ")
                p_text = dim(f"({c['path']})")
                print(f"  {status} {bold(c['name']):<20} {p_text}")
            else:
                if cat == "required":
                    status = red("✘ MISSING")
                elif cat == "recommended":
                    status = yellow("▲ MISSING")
                else:
                    status = dim("○ ABSENT ")
                print(f"  {status} {bold(c['name']):<20} {dim(c['description'])}")
        print()

    print(bold("Summary:"))
    if req_failed:
        print(f"  {red('Required dependencies missing:')} {len(req_failed)}")
        for rf in req_failed:
            print(f"    - {rf['name']} ({rf['description']})")
    else:
        print(f"  {green('All required core dependencies found.')}")

    if rec_failed:
        print(f"  {yellow('Recommended desktop components missing:')} {len(rec_failed)}")
        for rf in rec_failed:
            print(f"    - {rf['name']} ({rf['description']})")

    if opt_failed:
        print(f"  {dim(f'Optional tools absent: {len(opt_failed)}')}")

    print()
    return 0 if all_req_ok else 1


# ---------------------------------------------------------------------------
# Validate Command
# ---------------------------------------------------------------------------

def run_validate(args) -> int:
    """Automate syntax and integrity checks across Lua, JSONC, Shell, and Tokens."""
    target_root = os.path.abspath(getattr(args, "path", None) or os.getcwd())

    results = {
        "lua": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "jsonc": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "shell": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "tokens": {"total": 0, "passed": 0, "failed": 0, "errors": []},
    }

    # 1. Lua Validation
    lua_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__"]):
            continue
        for f in files:
            if f.endswith(".lua"):
                lua_files.append(os.path.join(root, f))

    has_luac = shutil.which("luac") is not None

    for lf in sorted(lua_files):
        results["lua"]["total"] += 1
        rel = os.path.relpath(lf, target_root)
        if has_luac:
            proc = subprocess.run(["luac", "-p", lf], capture_output=True, text=True)
            if proc.returncode == 0:
                results["lua"]["passed"] += 1
            else:
                results["lua"]["failed"] += 1
                results["lua"]["errors"].append({"file": rel, "error": proc.stderr.strip()})
        else:
            # Fallback to lua loadfile
            proc = subprocess.run(
                ["lua", "-e", f'local f, err = loadfile("{lf}"); assert(f, err)'],
                capture_output=True, text=True,
            )
            if proc.returncode == 0:
                results["lua"]["passed"] += 1
            else:
                results["lua"]["failed"] += 1
                results["lua"]["errors"].append({"file": rel, "error": proc.stderr.strip()})

    # 2. JSONC and JSON Validation
    json_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__", ".vscode"]):
            continue
        for f in files:
            if f.endswith(".json") or f.endswith(".jsonc"):
                json_files.append(os.path.join(root, f))

    for jf in sorted(json_files):
        results["jsonc"]["total"] += 1
        rel = os.path.relpath(jf, target_root)
        try:
            with open(jf, "r", encoding="utf-8") as f:
                content = f.read()
            cleaned = _strip_jsonc_comments(content)
            json.loads(cleaned)
            results["jsonc"]["passed"] += 1
        except Exception as e:
            results["jsonc"]["failed"] += 1
            results["jsonc"]["errors"].append({"file": rel, "error": str(e)})

    # 3. Shell Script Validation
    sh_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__"]):
            continue
        for f in files:
            if f.endswith(".sh"):
                sh_files.append(os.path.join(root, f))

    for sf in sorted(sh_files):
        results["shell"]["total"] += 1
        rel = os.path.relpath(sf, target_root)
        # Check executable flag
        if not os.access(sf, os.X_OK):
            results["shell"]["failed"] += 1
            results["shell"]["errors"].append({"file": rel, "error": "File is not executable (chmod +x needed)"})
            continue

        # Check syntax with bash -n
        proc = subprocess.run(["bash", "-n", sf], capture_output=True, text=True)
        if proc.returncode == 0:
            results["shell"]["passed"] += 1
        else:
            results["shell"]["failed"] += 1
            results["shell"]["errors"].append({"file": rel, "error": proc.stderr.strip()})

    # 4. Canonical Design Tokens Validation
    token_files = glob.glob(os.path.join(target_root, "core", "tokens", "*.json"))
    for tf in sorted(token_files):
        results["tokens"]["total"] += 1
        rel = os.path.relpath(tf, target_root)
        try:
            with open(tf, "r", encoding="utf-8") as f:
                tok_data = json.load(f)

            for key in ("name", "palette", "geometry", "blur"):
                if key not in tok_data:
                    raise ValueError(f"Missing required key '{key}' in design tokens")

            # Check essential palette keys
            if "void" not in tok_data["palette"] and "background" not in tok_data["palette"]:
                raise ValueError("Missing essential palette color 'void' or 'background'")
            for pkey in ("surface", "accent", "warning", "danger"):
                if pkey not in tok_data["palette"]:
                    raise ValueError(f"Missing essential palette color '{pkey}'")

            results["tokens"]["passed"] += 1
        except Exception as e:
            results["tokens"]["failed"] += 1
            results["tokens"]["errors"].append({"file": rel, "error": str(e)})

    # Verify generated token artifacts exist if core tokens are present
    if token_files:
        expected_artifacts = [
            "hypr/themes/noctis_amethyst.lua",
            "waybar/generated/theme-tokens.css",
            "rofi/generated/theme-tokens.rasi",
            "swaync/generated/theme-tokens.css",
            "hypr/generated/theme-tokens.conf",
            "kitty/generated/theme-tokens.conf",
            "wlogout/generated/theme-tokens.css",
        ]
        for art in expected_artifacts:
            art_path = os.path.join(target_root, art)
            results["tokens"]["total"] += 1
            if os.path.isfile(art_path) and os.path.getsize(art_path) > 0:
                results["tokens"]["passed"] += 1
            else:
                results["tokens"]["failed"] += 1
                results["tokens"]["errors"].append({
                    "file": art,
                    "error": f"Generated token artifact missing or empty: {art}",
                })

    total_failed = sum(v["failed"] for v in results.values())
    is_passed = (total_failed == 0)

    if getattr(args, "json", False):
        output = {
            "status": "ok" if is_passed else "error",
            "passed": is_passed,
            "target": target_root,
            "summary": results,
        }
        print(json.dumps(output, indent=2))
        return 0 if is_passed else 1

    # Human-readable output
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│               Obsyx Configuration Validator              │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Target: {dim(target_root)}\n")

    for cat, title in [
        ("lua", "Lua Compositor Configurations"),
        ("jsonc", "JSON / JSONC Module Stylesheets"),
        ("shell", "Shell Telemetry & Service Scripts"),
        ("tokens", "Design Tokens & Compiled Artifacts"),
    ]:
        data = results[cat]
        badge = green(f"✔ {data['passed']}/{data['total']} PASS") if data["failed"] == 0 else red(f"✘ {data['failed']} FAIL ({data['passed']}/{data['total']})")
        print(f"► {bold(title):<45} {badge}")
        if data["errors"]:
            for err in data["errors"]:
                print(f"    {red('FAIL:')} {err['file']}")
                print(f"          {dim(err['error'])}")

    print()
    if is_passed:
        print(bold(green("✔ Validation Passed: All configurations, scripts, and tokens are syntactically valid.")))
    else:
        print(bold(red(f"✘ Validation Failed: {total_failed} errors detected across the codebase.")))
    print()

    return 0 if is_passed else 1


# ---------------------------------------------------------------------------
# Install Command
# ---------------------------------------------------------------------------

SUPPORTED_COMPONENTS = {
    "hypr": ("hypr", "Hyprland compositor, themes, autostart, and hyprlock"),
    "waybar": ("waybar", "Waybar status bar, layouts, CSS, and telemetry scripts"),
    "rofi": ("rofi", "Rofi launcher, powermenu, cliphist, and glass theme"),
    "swaync": ("swaync", "SwayNC notification daemon and control center"),
    "kitty": ("kitty", "Kitty terminal emulator configuration and theme tokens"),
    "wlogout": ("wlogout", "Wlogout logout dialog layout and CSS theme"),
}


def run_install(args) -> int:
    """Safely install Obsyx desktop components with dry-run and automated backups."""
    from datetime import datetime

    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    raw_dest = getattr(args, "dest", None) or getattr(args, "target", None)
    if not raw_dest:
        raw_dest = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    dest_root = os.path.abspath(os.path.expanduser(raw_dest))

    is_dry_run = getattr(args, "dry_run", False)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    # Select components
    selected_keys = list(SUPPORTED_COMPONENTS.keys())
    if getattr(args, "components", None):
        user_comps = [c.strip().lower() for c in args.components.split(",") if c.strip()]
        selected_keys = [k for k in selected_keys if k in user_comps]

    if getattr(args, "skip", None):
        skip_comps = [c.strip().lower() for c in args.skip.split(",") if c.strip()]
        selected_keys = [k for k in selected_keys if k not in skip_comps]

    actions = []

    for comp in selected_keys:
        comp_dir, comp_desc = SUPPORTED_COMPONENTS[comp]
        src_path = os.path.join(repo_root, comp_dir)
        dest_path = os.path.join(dest_root, comp_dir)

        if not os.path.exists(src_path):
            actions.append({
                "component": comp,
                "status": "error",
                "message": f"Source directory missing in repository: {src_path}",
                "source": src_path,
                "dest": dest_path,
                "backup": None,
            })
            continue

        # Check existing destination
        if os.path.islink(dest_path):
            current_target = os.path.realpath(dest_path)
            expected_target = os.path.realpath(src_path)
            if current_target == expected_target:
                actions.append({
                    "component": comp,
                    "status": "already_linked",
                    "message": "Already linked to current repository",
                    "source": src_path,
                    "dest": dest_path,
                    "backup": None,
                })
                continue
            else:
                # Link exists but points elsewhere: backup the symlink
                backup_path = f"{dest_path}.backup.{timestamp}"
                if not is_dry_run:
                    os.rename(dest_path, backup_path)
                    os.symlink(src_path, dest_path)
                actions.append({
                    "component": comp,
                    "status": "backed_up_and_linked",
                    "message": f"Existing symlink backed up and re-linked",
                    "source": src_path,
                    "dest": dest_path,
                    "backup": backup_path,
                })
        elif os.path.exists(dest_path):
            # Real directory or file exists: create backup
            backup_path = f"{dest_path}.backup.{timestamp}"
            if not is_dry_run:
                shutil.move(dest_path, backup_path)
                os.symlink(src_path, dest_path)
            actions.append({
                "component": comp,
                "status": "backed_up_and_linked",
                "message": f"Existing directory backed up and linked",
                "source": src_path,
                "dest": dest_path,
                "backup": backup_path,
            })
        else:
            # Does not exist: fresh install
            if not is_dry_run:
                os.makedirs(dest_root, exist_ok=True)
                os.symlink(src_path, dest_path)
            actions.append({
                "component": comp,
                "status": "linked",
                "message": "Symlink created",
                "source": src_path,
                "dest": dest_path,
                "backup": None,
            })

    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "dry_run": is_dry_run,
            "destination": dest_root,
            "timestamp": timestamp,
            "actions": actions,
        }
        print(json.dumps(output, indent=2))
        return 0

    # Human-readable output
    title_suffix = " (DRY RUN SIMULATION)" if is_dry_run else ""
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│               Obsyx Desktop Safe Installer{title_suffix[:15]:<15}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    if is_dry_run:
        print(yellow(bold("⚡ DRY RUN: No modifications were made to the filesystem.\n")))
    print(f"Target Destination: {bold(dest_root)}\n")

    for act in actions:
        c_name = act["component"]
        c_status = act["status"]
        if c_status == "linked":
            badge = green("✔ LINKED   ")
        elif c_status == "already_linked":
            badge = cyan("○ ALREADY LINKED")
        elif c_status == "backed_up_and_linked":
            badge = yellow("▲ BACKUP+LINK   ")
        else:
            badge = red("✘ ERROR         ")

        print(f"  {badge:<18} {bold(c_name):<12} {act['dest']}")
        if act["backup"]:
            print(f"                     {dim('Backup created at: ' + act['backup'])}")

    print()
    if is_dry_run:
        print(bold(yellow("Simulation complete. Run without --dry-run to apply changes.")))
    else:
        print(bold(green("✔ Installation complete! All selected components are safely linked.")))
    print()

    return 0


# ---------------------------------------------------------------------------
# Keybinding Parser & Documentation Generator (docgen)
# ---------------------------------------------------------------------------

LUA_DOCGEN_EXTRACTOR = r"""
package.path = "./hypr/?.lua;./hypr/?/init.lua;" .. package.path

local function make_mock(name)
    name = name or "dsp"
    local t = {}
    local mt = {
        __index = function(self, key)
            local sub = make_mock(name .. "." .. tostring(key))
            rawset(self, key, sub)
            return sub
        end,
        __call = function(self, ...)
            local args = {...}
            local arg_strs = {}
            for i, a in ipairs(args) do
                if type(a) == "table" then
                    local parts = {}
                    for k, v in pairs(a) do table.insert(parts, tostring(k) .. "=" .. tostring(v)) end
                    table.insert(arg_strs, "{" .. table.concat(parts, ", ") .. "}")
                else
                    table.insert(arg_strs, tostring(a))
                end
            end
            if name == "dsp.exec_cmd" and #args > 0 then
                return tostring(args[1])
            end
            return name .. "(" .. table.concat(arg_strs, ", ") .. ")"
        end,
        __tostring = function(self) return name end
    }
    setmetatable(t, mt)
    return t
end

local all_binds = {}
local current_cat = "General"
local current_file = ""

_G.hl = {
    bind = function(key, action, opts)
        opts = opts or {}
        local act_str = tostring(action)
        local desc = opts.description
        if not desc or desc == "" then
            desc = act_str
        end
        table.insert(all_binds, {
            key = tostring(key),
            description = tostring(desc),
            action = act_str,
            category = current_cat,
            source_file = current_file,
            locked = opts.locked == true,
            repeating = opts.repeating == true,
            mouse = opts.mouse == true,
        })
    end,
    dsp = make_mock("dsp")
}

require("config.variables")

local modules = {
    { mod = "config.binds.apps", cat = "Applications & Launchers", file = "hypr/config/binds/apps.lua" },
    { mod = "config.binds.windows", cat = "Window Management", file = "hypr/config/binds/windows.lua" },
    { mod = "config.binds.workspaces", cat = "Workspace Navigation", file = "hypr/config/binds/workspaces.lua" },
    { mod = "config.binds.screenshots", cat = "Screenshots", file = "hypr/config/binds/screenshots.lua" },
    { mod = "config.binds.media", cat = "Media & Hardware Controls", file = "hypr/config/binds/media.lua" },
    { mod = "config.binds.system", cat = "System & Session Controls", file = "hypr/config/binds/system.lua" },
}

for _, m in ipairs(modules) do
    current_cat = m.cat
    current_file = m.file
    local ok, err = pcall(require, m.mod)
    if not ok then
        io.stderr:write("Error loading " .. m.mod .. ": " .. tostring(err) .. "\n")
    end
end

local function jstr(s)
    s = tostring(s or "")
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r")
    return "\"" .. s .. "\""
end

local items = {}
for _, b in ipairs(all_binds) do
    local obj = string.format(
        "{\"key\": %s, \"description\": %s, \"action\": %s, \"category\": %s, \"source_file\": %s, \"locked\": %s, \"repeating\": %s, \"mouse\": %s}",
        jstr(b.key), jstr(b.description), jstr(b.action), jstr(b.category), jstr(b.source_file),
        tostring(b.locked), tostring(b.repeating), tostring(b.mouse)
    )
    table.insert(items, obj)
end

print("{\"total\": " .. #items .. ", \"binds\": [" .. table.concat(items, ",") .. "]}")
"""


def extract_keybindings(repo_root: str) -> list:
    """Extract all active keybindings from Hyprland Lua configuration."""
    if shutil.which("lua"):
        try:
            proc = subprocess.run(
                ["lua", "-e", LUA_DOCGEN_EXTRACTOR],
                capture_output=True,
                text=True,
                cwd=repo_root,
                timeout=5,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                data = json.loads(proc.stdout)
                if "binds" in data and len(data["binds"]) > 0:
                    return data["binds"]
        except Exception:
            pass

    # Static fallback if lua runtime is not available
    binds = []
    binds_dir = os.path.join(repo_root, "hypr", "config", "binds")
    if not os.path.exists(binds_dir):
        return binds

    apps_file = os.path.join(binds_dir, "apps.lua")
    if os.path.exists(apps_file):
        with open(apps_file, "r", encoding="utf-8") as f:
            content = f.read()
        for match in re.finditer(r'\{\s*"([^"]+)"\s*,\s*([^,\s]+)\s*(?:,\s*"([^"]+)")?\s*\}', content):
            key = f"SUPER + {match.group(1)}"
            cmd = match.group(2)
            desc = match.group(3) or cmd
            binds.append({
                "key": key,
                "description": desc,
                "action": cmd,
                "category": "Applications & Launchers",
                "source_file": "hypr/config/binds/apps.lua",
                "locked": False,
                "repeating": False,
                "mouse": False,
            })

    return binds


def generate_markdown(binds: list) -> str:
    """Generate GFM markdown cheatsheet for keybindings."""
    lines = [
        "# Obsyx Keybindings Cheatsheet",
        "",
        "> **Environment:** Hyprland + Noctis Amethyst<br/>",
        "> **Modifier Key (`MOD`):** `SUPER` (Windows / Command key)<br/>",
        "> **Source Configurations:** `hypr/config/binds/*.lua` and `hypr/config/variables.lua`<br/>",
        "> *Note: Automatically generated by `obsyx docgen`.*",
        "",
        "---",
        "",
        "## Categories Overview",
        "",
        "| Category | Shortcuts | Description |",
        "| :--- | :---: | :--- |",
    ]

    cats = {}
    cat_order = [
        "Applications & Launchers",
        "Window Management",
        "Workspace Navigation",
        "Screenshots",
        "Media & Hardware Controls",
        "System & Session Controls",
    ]
    for b in binds:
        cat = b.get("category", "General")
        cats.setdefault(cat, []).append(b)

    cat_descs = {
        "Applications & Launchers": "Core applications, terminal, browser, and desktop launcher",
        "Window Management": "Window tiling, floating, fullscreen, layout split, focus, and drag/resize",
        "Workspace Navigation": "Workspaces 1-10, scratchpads, and active window movement",
        "Screenshots": "Screen, window, and region captures via hyprshot",
        "Media & Hardware Controls": "Audio volume, microphone mute, monitor brightness, and media playback",
        "System & Session Controls": "Session lock, power menu, logout, suspend, reboot, and power off",
    }

    for cat in cat_order:
        if cat in cats:
            count = len(cats[cat])
            desc = cat_descs.get(cat, "")
            slug = cat.lower().replace(" & ", "-").replace(" ", "-")
            lines.append(f"| [{cat}](#{slug}) | {count} | {desc} |")

    lines.append("")
    lines.append("---")
    lines.append("")

    def format_key_kbd(key_str: str) -> str:
        parts = [p.strip() for p in key_str.split("+")]
        return " + ".join(f"<kbd>{p}</kbd>" for p in parts)

    for cat in cat_order:
        if cat not in cats:
            continue
        c_binds = cats[cat]
        lines.append(f"## {cat}")
        lines.append("")
        lines.append("| Shortcut | Description | Action / Command |")
        lines.append("| :--- | :--- | :--- |")
        for b in c_binds:
            kbd_str = format_key_kbd(b["key"])
            desc = b.get("description", "").replace("|", "\\|")
            act = b.get("action", "").replace("|", "\\|")
            lines.append(f"| {kbd_str} | {desc} | `{act}` |")
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def generate_rofi_script(binds: list) -> str:
    """Generate interactive Rofi keybinding search script."""
    entries_code = []
    actions_code = []

    for b in binds:
        key = b["key"]
        desc = b.get("description", "")
        cat = b.get("category", "")
        act = b.get("action", "")

        entry_line = f"{key:<26} │ {desc:<28} │ {cat}"
        escaped_entry = entry_line.replace('"', '\\"')
        escaped_action = act.replace('"', '\\"')

        entries_code.append(f'    "{escaped_entry}"')
        actions_code.append(f'    "{escaped_action}"')

    entries_block = "\n".join(entries_code)
    actions_block = "\n".join(actions_code)

    script = f"""#!/usr/bin/env bash
# Obsyx - Interactive Keybinding Search & Launcher
# Search all configured shortcuts and optionally execute their action.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${{BASH_SOURCE[0]}}")" && pwd)"
ROFI_DIR="$(cd "${{SCRIPT_DIR}}/.." && pwd)"
THEME="${{ROFI_DIR}}/app-launcher.rasi"

if ! command -v rofi >/dev/null 2>&1; then
    echo "Error: rofi is not installed or not in PATH" >&2
    exit 1
fi

ROFI_ARGS=(-i -p "Shortcuts" -format i)
if [[ -f "${{THEME}}" ]]; then
    ROFI_ARGS+=(-theme "${{THEME}}")
fi

declare -a ENTRIES=(
{entries_block}
)

declare -a ACTIONS=(
{actions_block}
)

# Render menu and capture selection index
INDEX="$(printf "%s\\n" "${{ENTRIES[@]}}" | rofi -dmenu "${{ROFI_ARGS[@]}}" || true)"

if [[ -z "${{INDEX}}" ]]; then
    exit 0
fi

ACTION="${{ACTIONS[INDEX]:-}}"
if [[ -z "${{ACTION}}" ]]; then
    exit 0
fi

# Dispatch or execute action
if [[ "${{ACTION}}" == dsp.* ]]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Obsyx Keybinding" "${{ENTRIES[INDEX]}}"
    fi
else
    # Shell command execution
    eval "${{ACTION}} &"
fi
"""
    return script.strip() + "\n"


def run_docgen(args) -> int:
    """Run docgen subcommand."""
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    binds = extract_keybindings(repo_root)

    if getattr(args, "json", False):
        cats = sorted(list({b["category"] for b in binds}))
        output = {
            "status": "ok",
            "total": len(binds),
            "categories": cats,
            "keybindings": binds,
        }
        print(json.dumps(output, indent=2))
        return 0

    target_md = getattr(args, "output", None) or os.path.join(repo_root, "KEYBINDINGS.md")
    target_rofi = getattr(args, "rofi_script", None) or os.path.join(repo_root, "rofi", "scripts", "keybindings.sh")

    new_md_content = generate_markdown(binds)
    new_rofi_content = generate_rofi_script(binds)

    is_check = getattr(args, "check", False)

    if is_check:
        mismatched = []
        if not os.path.exists(target_md):
            mismatched.append(f"Missing {target_md}")
        else:
            with open(target_md, "r", encoding="utf-8") as f:
                if f.read() != new_md_content:
                    mismatched.append(f"Outdated {target_md}")

        if not os.path.exists(target_rofi):
            mismatched.append(f"Missing {target_rofi}")
        else:
            with open(target_rofi, "r", encoding="utf-8") as f:
                if f.read() != new_rofi_content:
                    mismatched.append(f"Outdated {target_rofi}")

        if mismatched:
            print(red(f"✘ Documentation check failed: {', '.join(mismatched)}"))
            return 1
        print(green("✔ Documentation check passed: All cheatsheets are up to date."))
        return 0

    # Write output files
    os.makedirs(os.path.dirname(os.path.abspath(target_md)), exist_ok=True)
    with open(target_md, "w", encoding="utf-8") as f:
        f.write(new_md_content)

    os.makedirs(os.path.dirname(os.path.abspath(target_rofi)), exist_ok=True)
    with open(target_rofi, "w", encoding="utf-8") as f:
        f.write(new_rofi_content)
    os.chmod(target_rofi, 0o755)

    num_cats = len({b["category"] for b in binds})
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│           Obsyx Keybinding Cheatsheet Generator          │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Extracted {bold(str(len(binds)))} keybindings across {bold(str(num_cats))} categories.\n")
    print(f"  {green('✔ GENERATED')} {bold('KEYBINDINGS.md')}       -> {target_md}")
    print(f"  {green('✔ GENERATED')} {bold('keybindings.sh')}        -> {target_rofi}")
    print()

    return 0


# ---------------------------------------------------------------------------
# Main CLI Entrypoint
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="obsyx",
        description="Obsyx — Modular Hyprland desktop environment framework CLI.",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"Obsyx v{VERSION}",
        help="Show Obsyx version.",
    )

    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # Doctor
    doc_parser = subparsers.add_parser("doctor", help="Check system dependencies and desktop runtime tooling.")
    doc_parser.add_argument("--json", action="store_true", help="Output diagnostic report as JSON.")
    doc_parser.add_argument("--verbose", "-v", action="store_true", help="Enable verbose diagnostics.")

    # Validate
    val_parser = subparsers.add_parser("validate", help="Validate Lua, JSONC, Shell scripts, and design tokens.")
    val_parser.add_argument("--path", "-p", help="Target configuration directory to validate (default: current directory).")
    val_parser.add_argument("--json", action="store_true", help="Output validation results as JSON.")
    val_parser.add_argument("--verbose", "-v", action="store_true", help="Enable verbose validation output.")

    # Install
    ins_parser = subparsers.add_parser("install", help="Safely install Obsyx desktop configuration with backups and dry-run.")
    ins_parser.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    ins_parser.add_argument("--dry-run", action="store_true", help="Simulate installation without touching the filesystem.")
    ins_parser.add_argument("--components", "-c", help="Comma-separated components to install (e.g. hypr,waybar,kitty).")
    ins_parser.add_argument("--skip", "-s", help="Comma-separated components to skip.")
    ins_parser.add_argument("--json", action="store_true", help="Output installation plan/result as JSON.")

    # Docgen
    docgen_parser = subparsers.add_parser("docgen", help="Generate keybindings cheatsheet (KEYBINDINGS.md) and Rofi search script.")
    docgen_parser.add_argument("--output", "-o", help="Target markdown cheatsheet output path (default: KEYBINDINGS.md).")
    docgen_parser.add_argument("--rofi-script", "-r", help="Target Rofi search script output path (default: rofi/scripts/keybindings.sh).")
    docgen_parser.add_argument("--check", action="store_true", help="Check whether generated files are up to date without writing.")
    docgen_parser.add_argument("--json", action="store_true", help="Output keybindings data as JSON.")

    args = parser.parse_args()

    if args.command == "doctor":
        sys.exit(run_doctor(args))
    elif args.command == "validate":
        sys.exit(run_validate(args))
    elif args.command == "install":
        sys.exit(run_install(args))
    elif args.command == "docgen":
        sys.exit(run_docgen(args))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
