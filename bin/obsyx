#!/usr/bin/env python3
"""Obsyx CLI Core & Diagnostic Validator.

Usage:
    obsyx --version
    obsyx --help
    obsyx doctor [--json] [--verbose]
    obsyx validate [--path PATH] [--json] [--verbose]
"""

import argparse
from datetime import datetime
import glob
import json
import os
import re
import shutil
import subprocess
import sys

VERSION = "0.1.0"

# ANSI Terminal Colors
USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text

def bold(text: str) -> str: return _c("1", text)
def green(text: str) -> str: return _c("32", text)
def yellow(text: str) -> str: return _c("33", text)
def red(text: str) -> str: return _c("31", text)
def cyan(text: str) -> str: return _c("36", text)
def dim(text: str) -> str: return _c("2", text)


def _strip_jsonc_comments(text: str) -> str:
    """Remove single-line (//) and multi-line (/* */) comments from JSONC text."""
    pattern = re.compile(
        r'//.*?$|/\*.*?\*/|"(?:\\.|[^\\"])*"',
        re.DOTALL | re.MULTILINE,
    )
    def replacer(match):
        s = match.group(0)
        return ' ' if s.startswith('/') else s
    return re.sub(pattern, replacer, text)


# ---------------------------------------------------------------------------
# Doctor Command
# ---------------------------------------------------------------------------

def run_doctor(args) -> int:
    """Check system dependencies and desktop runtime tooling."""
    checks = []

    # Category definitions
    required_bins = [
        ("Hyprland", ["hyprland", "Hyprland"], "Compositor binary"),
        ("Waybar", ["waybar"], "Status bar"),
        ("Bash", ["bash"], "Shell interpreter"),
        ("Python3", ["python3"], "CLI and compiler runtime"),
        ("Lua", ["lua"], "Configuration runtime"),
        ("Luac", ["luac"], "Lua syntax compiler"),
    ]

    recommended_bins = [
        ("SwayNC", ["swaync", "swaync-client"], "Notification daemon & control center"),
        ("Hyprlock", ["hyprlock"], "Screen locker"),
        ("Rofi", ["rofi"], "Application launcher & menu modal"),
        ("Wlogout", ["wlogout"], "Session & power menu overlay"),
        ("Wallpaper Daemon", ["swww", "swww-daemon", "hyprpaper"], "Wallpaper renderer daemon"),
        ("Kitty", ["kitty"], "Terminal emulator"),
        ("wl-copy", ["wl-copy"], "Wayland clipboard utility"),
        ("cliphist", ["cliphist"], "Clipboard history daemon"),
        ("Polkit Agent", [
            "/usr/lib/hyprpolkitagent/hyprpolkitagent",
            "/usr/libexec/hyprpolkitagent",
            "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1",
            "/usr/libexec/polkit-gnome-authentication-agent-1",
            "/usr/lib/polkit-kde-authentication-agent-1",
            "hyprpolkitagent",
            "lxpolkit",
        ], "Privilege escalation authentication agent"),
    ]

    optional_bins = [
        ("playerctl", ["playerctl"], "MPRIS media player controls"),
        ("brightnessctl", ["brightnessctl"], "Display backlight controls"),
        ("hyprshot", ["hyprshot"], "Screenshot utility"),
        ("hyprpicker", ["hyprpicker"], "Screen color picker"),
        ("Network Applet", ["nm-applet"], "NetworkManager tray indicator"),
        ("Bluetooth Applet", ["blueman-applet"], "Bluetooth tray indicator"),
        ("ImageMagick", ["magick", "convert"], "Asset rasterizer"),
    ]

    def _evaluate(name: str, candidates: list, desc: str, category: str):
        found_path = None
        for cand in candidates:
            if cand.startswith("/"):
                if os.path.isfile(cand) and os.access(cand, os.X_OK):
                    found_path = cand
                    break
            else:
                p = shutil.which(cand)
                if p:
                    found_path = p
                    break
        checks.append({
            "name": name,
            "category": category,
            "description": desc,
            "found": found_path is not None,
            "path": found_path,
        })

    for name, cands, desc in required_bins:
        _evaluate(name, cands, desc, "required")

    for name, cands, desc in recommended_bins:
        _evaluate(name, cands, desc, "recommended")

    for name, cands, desc in optional_bins:
        _evaluate(name, cands, desc, "optional")

    req_failed = [c for c in checks if c["category"] == "required" and not c["found"]]
    rec_failed = [c for c in checks if c["category"] == "recommended" and not c["found"]]
    opt_failed = [c for c in checks if c["category"] == "optional" and not c["found"]]

    all_req_ok = len(req_failed) == 0
    status_str = "ok" if all_req_ok and len(rec_failed) == 0 else ("warning" if all_req_ok else "error")

    if getattr(args, "json", False):
        output = {
            "status": status_str,
            "summary": {
                "total": len(checks),
                "required_total": len(required_bins),
                "required_missing": len(req_failed),
                "recommended_total": len(recommended_bins),
                "recommended_missing": len(rec_failed),
                "optional_total": len(optional_bins),
                "optional_missing": len(opt_failed),
            },
            "checks": checks,
        }
        print(json.dumps(output, indent=2))
        return 0 if all_req_ok else 1

    # Human-readable output
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│               Obsyx Doctor Diagnostic Check              │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))

    for cat, title, badge in [
        ("required", "Required Core Tooling", "REQUIRED"),
        ("recommended", "Recommended Desktop Components", "RECOMMENDED"),
        ("optional", "Optional Utilities & Applets", "OPTIONAL"),
    ]:
        print(bold(f"► {title}"))
        for c in checks:
            if c["category"] != cat:
                continue
            if c["found"]:
                status = green("✔ FOUND ")
                p_text = dim(f"({c['path']})")
                print(f"  {status} {bold(c['name']):<20} {p_text}")
            else:
                if cat == "required":
                    status = red("✘ MISSING")
                elif cat == "recommended":
                    status = yellow("▲ MISSING")
                else:
                    status = dim("○ ABSENT ")
                print(f"  {status} {bold(c['name']):<20} {dim(c['description'])}")
        print()

    print(bold("Summary:"))
    if req_failed:
        print(f"  {red('Required dependencies missing:')} {len(req_failed)}")
        for rf in req_failed:
            print(f"    - {rf['name']} ({rf['description']})")
    else:
        print(f"  {green('All required core dependencies found.')}")

    if rec_failed:
        print(f"  {yellow('Recommended desktop components missing:')} {len(rec_failed)}")
        for rf in rec_failed:
            print(f"    - {rf['name']} ({rf['description']})")

    if opt_failed:
        print(f"  {dim(f'Optional tools absent: {len(opt_failed)}')}")

    print()
    return 0 if all_req_ok else 1


# ---------------------------------------------------------------------------
# Validate Command
# ---------------------------------------------------------------------------

def run_validate(args) -> int:
    """Automate syntax and integrity checks across Lua, JSONC, Shell, and Tokens."""
    target_root = os.path.abspath(getattr(args, "path", None) or os.getcwd())

    results = {
        "lua": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "jsonc": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "shell": {"total": 0, "passed": 0, "failed": 0, "errors": []},
        "tokens": {"total": 0, "passed": 0, "failed": 0, "errors": []},
    }

    # 1. Lua Validation
    lua_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__"]):
            continue
        for f in files:
            if f.endswith(".lua"):
                lua_files.append(os.path.join(root, f))

    has_luac = shutil.which("luac") is not None

    for lf in sorted(lua_files):
        results["lua"]["total"] += 1
        rel = os.path.relpath(lf, target_root)
        if has_luac:
            proc = subprocess.run(["luac", "-p", lf], capture_output=True, text=True)
            if proc.returncode == 0:
                results["lua"]["passed"] += 1
            else:
                results["lua"]["failed"] += 1
                results["lua"]["errors"].append({"file": rel, "error": proc.stderr.strip()})
        else:
            # Fallback to lua loadfile
            proc = subprocess.run(
                ["lua", "-e", f'local f, err = loadfile("{lf}"); assert(f, err)'],
                capture_output=True, text=True,
            )
            if proc.returncode == 0:
                results["lua"]["passed"] += 1
            else:
                results["lua"]["failed"] += 1
                results["lua"]["errors"].append({"file": rel, "error": proc.stderr.strip()})

    # 2. JSONC and JSON Validation
    json_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__", ".vscode"]):
            continue
        for f in files:
            if f.endswith(".json") or f.endswith(".jsonc"):
                json_files.append(os.path.join(root, f))

    for jf in sorted(json_files):
        results["jsonc"]["total"] += 1
        rel = os.path.relpath(jf, target_root)
        try:
            with open(jf, "r", encoding="utf-8") as f:
                content = f.read()
            cleaned = _strip_jsonc_comments(content)
            json.loads(cleaned)
            results["jsonc"]["passed"] += 1
        except Exception as e:
            results["jsonc"]["failed"] += 1
            results["jsonc"]["errors"].append({"file": rel, "error": str(e)})

    # 3. Shell Script Validation
    sh_files = []
    for root, _, files in os.walk(target_root):
        if any(ignored in root for ignored in [".git", "node_modules", ".gemini", "__pycache__"]):
            continue
        for f in files:
            if f.endswith(".sh"):
                sh_files.append(os.path.join(root, f))

    for sf in sorted(sh_files):
        results["shell"]["total"] += 1
        rel = os.path.relpath(sf, target_root)
        # Check executable flag
        if not os.access(sf, os.X_OK):
            results["shell"]["failed"] += 1
            results["shell"]["errors"].append({"file": rel, "error": "File is not executable (chmod +x needed)"})
            continue

        # Check syntax with bash -n
        proc = subprocess.run(["bash", "-n", sf], capture_output=True, text=True)
        if proc.returncode == 0:
            results["shell"]["passed"] += 1
        else:
            results["shell"]["failed"] += 1
            results["shell"]["errors"].append({"file": rel, "error": proc.stderr.strip()})

    # 4. Canonical Design Tokens Validation
    token_files = glob.glob(os.path.join(target_root, "core", "tokens", "*.json"))
    for tf in sorted(token_files):
        results["tokens"]["total"] += 1
        rel = os.path.relpath(tf, target_root)
        try:
            with open(tf, "r", encoding="utf-8") as f:
                tok_data = json.load(f)

            for key in ("name", "palette", "geometry", "blur"):
                if key not in tok_data:
                    raise ValueError(f"Missing required key '{key}' in design tokens")

            # Check essential palette keys
            if "void" not in tok_data["palette"] and "background" not in tok_data["palette"]:
                raise ValueError("Missing essential palette color 'void' or 'background'")
            for pkey in ("surface", "accent", "warning", "danger"):
                if pkey not in tok_data["palette"]:
                    raise ValueError(f"Missing essential palette color '{pkey}'")

            results["tokens"]["passed"] += 1
        except Exception as e:
            results["tokens"]["failed"] += 1
            results["tokens"]["errors"].append({"file": rel, "error": str(e)})

    # Verify generated token artifacts exist if core tokens are present
    if token_files:
        expected_artifacts = [
            "hypr/themes/noctis_amethyst.lua",
            "hypr/themes/obsidian.lua",
            "hypr/themes/frost.lua",
            "hypr/themes/aurora.lua",
            "hypr/themes/ember.lua",
            "waybar/generated/theme-tokens.css",
            "rofi/generated/theme-tokens.rasi",
            "swaync/generated/theme-tokens.css",
            "hypr/generated/theme-tokens.conf",
            "kitty/generated/theme-tokens.conf",
            "wlogout/generated/theme-tokens.css",
        ]
        for art in expected_artifacts:
            art_path = os.path.join(target_root, art)
            results["tokens"]["total"] += 1
            if os.path.isfile(art_path) and os.path.getsize(art_path) > 0:
                results["tokens"]["passed"] += 1
            else:
                results["tokens"]["failed"] += 1
                results["tokens"]["errors"].append({
                    "file": art,
                    "error": f"Generated token artifact missing or empty: {art}",
                })

    total_failed = sum(v["failed"] for v in results.values())
    is_passed = (total_failed == 0)

    if getattr(args, "json", False):
        output = {
            "status": "ok" if is_passed else "error",
            "passed": is_passed,
            "target": target_root,
            "summary": results,
        }
        print(json.dumps(output, indent=2))
        return 0 if is_passed else 1

    # Human-readable output
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│               Obsyx Configuration Validator              │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Target: {dim(target_root)}\n")

    for cat, title in [
        ("lua", "Lua Compositor Configurations"),
        ("jsonc", "JSON / JSONC Module Stylesheets"),
        ("shell", "Shell Telemetry & Service Scripts"),
        ("tokens", "Design Tokens & Compiled Artifacts"),
    ]:
        data = results[cat]
        badge = green(f"✔ {data['passed']}/{data['total']} PASS") if data["failed"] == 0 else red(f"✘ {data['failed']} FAIL ({data['passed']}/{data['total']})")
        print(f"► {bold(title):<45} {badge}")
        if data["errors"]:
            for err in data["errors"]:
                print(f"    {red('FAIL:')} {err['file']}")
                print(f"          {dim(err['error'])}")

    print()
    if is_passed:
        print(bold(green("✔ Validation Passed: All configurations, scripts, and tokens are syntactically valid.")))
    else:
        print(bold(red(f"✘ Validation Failed: {total_failed} errors detected across the codebase.")))
    print()

    return 0 if is_passed else 1


# ---------------------------------------------------------------------------
# Install Command
# ---------------------------------------------------------------------------

SUPPORTED_COMPONENTS = {
    "hypr": ("hypr", "Hyprland compositor, themes, autostart, and hyprlock"),
    "waybar": ("waybar", "Waybar status bar, layouts, CSS, and telemetry scripts"),
    "rofi": ("rofi", "Rofi launcher, powermenu, cliphist, and glass theme"),
    "swaync": ("swaync", "SwayNC notification daemon and control center"),
    "kitty": ("kitty", "Kitty terminal emulator configuration and theme tokens"),
    "wlogout": ("wlogout", "Wlogout logout dialog layout and CSS theme"),
}


def prompt_choice(prompt_text: str, options: list, default_idx: int = 0) -> str:
    """Prompt user to choose from a list of (key, description) options."""
    print(bold(f"\n{prompt_text}"))
    for idx, (key, desc) in enumerate(options, 1):
        def_marker = " (default)" if (idx - 1) == default_idx else ""
        print(f"  {bold(cyan(str(idx)))} • {bold(key)}: {dim(desc)}{def_marker}")

    while True:
        try:
            val = input(bold(f"\nEnter choice [1-{len(options)}] (default: {default_idx + 1}): ")).strip()
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            sys.exit(0)
        if not val:
            return options[default_idx][0]
        try:
            n = int(val)
            if 1 <= n <= len(options):
                return options[n - 1][0]
        except ValueError:
            pass
        print(red(f"Invalid selection. Please enter a number between 1 and {len(options)}."))


def prompt_text_input(prompt_text: str, default_val: str) -> str:
    """Prompt user for text input with default value."""
    try:
        val = input(bold(f"{prompt_text} [{default_val}]: ")).strip()
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        sys.exit(0)
    return val if val else default_val


def prompt_yes_no(prompt_text: str, default_yes: bool = True) -> bool:
    """Prompt user for a yes/no confirmation."""
    opts = "Y/n" if default_yes else "y/N"
    while True:
        try:
            val = input(bold(f"{prompt_text} [{opts}]: ")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nCancelled.")
            sys.exit(0)
        if not val:
            return default_yes
        if val in ("y", "yes"):
            return True
        if val in ("n", "no"):
            return False
        print(red("Please enter 'y' or 'n'."))


def run_interactive_installer(repo_root: str, default_dest: str) -> dict:
    """Guide the user through an interactive Obsyx desktop installation session."""
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│            Obsyx Desktop Interactive Installer           │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print("Welcome to Obsyx! This wizard guides you through deploying and")
    print("personalizing your modular Wayland desktop environment.\n")

    # Step 1: Pre-flight Package Check
    print(bold(cyan("► Step 1: System Pre-flight & Dependency Check")))
    tools_to_check = [
        ("hyprland", "Hyprland Wayland compositor", True),
        ("waybar", "Waybar modular status bar", True),
        ("rofi", "Rofi application launcher", False),
        ("swaync", "SwayNC notification daemon", False),
        ("kitty", "Kitty GPU-accelerated terminal", False),
        ("wlogout", "Wlogout session logout interface", False),
    ]
    detected_count = 0
    for binary, desc, is_req in tools_to_check:
        found = shutil.which(binary) is not None
        if found:
            detected_count += 1
            print(f"  {green('✔ FOUND   ')} {bold(binary):<12} {dim(desc)}")
        else:
            tag = red("✘ MISSING (REQUIRED)") if is_req else yellow("○ OPTIONAL (NOT FOUND)")
            print(f"  {tag:<22} {bold(binary):<12} {dim(desc)}")
    print(f"\n  Detected {detected_count}/{len(tools_to_check)} desktop environment packages.\n")

    # Step 2: Destination path
    print(bold(cyan("► Step 2: Target Configuration Destination")))
    print(dim("Specify where Obsyx dotfiles should be deployed."))
    dest_path = prompt_text_input("Install destination directory", default_dest)
    dest_path = os.path.abspath(os.path.expanduser(dest_path))

    # Detect existing configurations that will be backed up
    existing = []
    for comp in SUPPORTED_COMPONENTS:
        t_path = os.path.join(dest_path, comp)
        if os.path.exists(t_path) and not (os.path.islink(t_path) and os.path.realpath(t_path) == os.path.realpath(os.path.join(repo_root, comp))):
            existing.append(comp)
    if existing:
        print(yellow(f"\n  Note: Existing configurations found for: {', '.join(existing)}."))
        print(yellow(f"  Existing configs will be safely backed up with timestamped filenames."))

    # Step 3: Installation Profile / Preset
    print(bold(cyan("\n► Step 3: Component Installation Preset")))
    preset = prompt_choice(
        "Choose an installation preset:",
        [
            ("Full", "Install all components: Hyprland, Waybar, Rofi, SwayNC, Kitty, Wlogout"),
            ("Minimal", "Install core compositor and status bar only: Hyprland, Waybar"),
            ("Custom", "Interactively select each individual desktop component"),
        ],
        default_idx=0
    )

    if preset == "Full":
        selected_components = list(SUPPORTED_COMPONENTS.keys())
    elif preset == "Minimal":
        selected_components = ["hypr", "waybar"]
    else:
        print(bold("\nSelect components to include (enter 'y' to include, 'n' to exclude):"))
        selected_components = []
        for comp, (_, desc) in SUPPORTED_COMPONENTS.items():
            if prompt_yes_no(f"Include {bold(comp)} ({desc})?", default_yes=True):
                selected_components.append(comp)
        if not selected_components:
            print(yellow("No components selected; defaulting to core 'hypr'."))
            selected_components = ["hypr"]

    # Step 4: Initial Theme Selection
    print(bold(cyan("\n► Step 4: Initial Official Theme Selection")))
    theme_choice = prompt_choice(
        "Select your default active desktop theme:",
        [
            ("noctis_amethyst", "Noctis Amethyst — Regal nocturnal purple & soft lavender glass (Reference Theme)"),
            ("obsidian", "Obsidian — Monolithic dark stone, matte graphite & cool platinum accents"),
            ("frost", "Frost — Crystalline polar slate & ice-blue sub-zero clarity"),
            ("aurora", "Aurora — Midnight oceanic teal, emerald luminescence & Arctic sky"),
            ("ember", "Ember — Volcanic basalt rock, glowing embers & warm magma copper"),
        ],
        default_idx=0
    )

    # Step 5: Hardware Form-Factor Profile
    print(bold(cyan("\n► Step 5: Hardware Profile Tuning")))
    profile_choice = prompt_choice(
        "Select hardware form-factor profile:",
        [
            ("default", "Standard desktop configuration (balanced blur and full layout)"),
            ("workstation", "Workstation — Expanded multi-monitor cluster and rich telemetry"),
            ("laptop", "Laptop — Battery-saving mode, reduced blur passes, and compact bar"),
        ],
        default_idx=0
    )

    # Step 6: Confirmation Review & Action Choice
    print(bold(cyan("\n► Step 6: Confirmation & Review")))
    print(f"  • Target Destination: {bold(dest_path)}")
    print(f"  • Preset:             {bold(preset)}")
    print(f"  • Components:         {bold(', '.join(selected_components))}")
    print(f"  • Active Theme:       {bold(theme_choice)}")
    print(f"  • Hardware Profile:   {bold(profile_choice)}")
    if existing:
        print(f"  • Automated Backups:  {yellow(', '.join(existing))}")

    confirm_action = prompt_choice(
        "Ready to proceed?",
        [
            ("install", "Proceed with live installation and configuration"),
            ("dry_run", "Simulate installation without touching the filesystem (Dry Run)"),
            ("cancel", "Cancel installation and exit"),
        ],
        default_idx=0
    )

    if confirm_action == "cancel":
        print("\nInstallation aborted by user.")
        sys.exit(0)

    is_dry_run = (confirm_action == "dry_run")
    return {
        "dest": dest_path,
        "components": selected_components,
        "theme": theme_choice,
        "profile": profile_choice if profile_choice != "default" else None,
        "dry_run": is_dry_run,
    }


def run_install(args) -> int:
    """Safely install Obsyx desktop components with dry-run and automated backups."""
    from datetime import datetime

    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    raw_dest = getattr(args, "dest", None) or getattr(args, "target", None)
    if not raw_dest:
        raw_dest = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    dest_root = os.path.abspath(os.path.expanduser(raw_dest))

    is_dry_run = getattr(args, "dry_run", False)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    applied_theme = None
    applied_profile = None

    # Interactive Wizard Mode
    if getattr(args, "interactive", False):
        cfg = run_interactive_installer(repo_root, dest_root)
        dest_root = cfg["dest"]
        selected_keys = cfg["components"]
        is_dry_run = cfg["dry_run"]
        applied_theme = cfg.get("theme")
        applied_profile = cfg.get("profile")
    else:
        # Select components from arguments
        selected_keys = list(SUPPORTED_COMPONENTS.keys())
        if getattr(args, "components", None):
            user_comps = [c.strip().lower() for c in args.components.split(",") if c.strip()]
            selected_keys = [k for k in selected_keys if k in user_comps]

        if getattr(args, "skip", None):
            skip_comps = [c.strip().lower() for c in args.skip.split(",") if c.strip()]
            selected_keys = [k for k in selected_keys if k not in skip_comps]

    actions = []

    for comp in selected_keys:
        comp_dir, comp_desc = SUPPORTED_COMPONENTS[comp]
        src_path = os.path.join(repo_root, comp_dir)
        dest_path = os.path.join(dest_root, comp_dir)

        if not os.path.exists(src_path):
            actions.append({
                "component": comp,
                "status": "error",
                "message": f"Source directory missing in repository: {src_path}",
                "source": src_path,
                "dest": dest_path,
                "backup": None,
            })
            continue

        # Check existing destination
        if os.path.islink(dest_path):
            current_target = os.path.realpath(dest_path)
            expected_target = os.path.realpath(src_path)
            if current_target == expected_target:
                actions.append({
                    "component": comp,
                    "status": "already_linked",
                    "message": "Already linked to current repository",
                    "source": src_path,
                    "dest": dest_path,
                    "backup": None,
                })
                continue
            else:
                # Link exists but points elsewhere: backup the symlink
                backup_path = f"{dest_path}.backup.{timestamp}"
                if not is_dry_run:
                    os.rename(dest_path, backup_path)
                    os.symlink(src_path, dest_path)
                actions.append({
                    "component": comp,
                    "status": "backed_up_and_linked",
                    "message": f"Existing symlink backed up and re-linked",
                    "source": src_path,
                    "dest": dest_path,
                    "backup": backup_path,
                })
        elif os.path.exists(dest_path):
            # Real directory or file exists: create backup
            backup_path = f"{dest_path}.backup.{timestamp}"
            if not is_dry_run:
                shutil.move(dest_path, backup_path)
                os.symlink(src_path, dest_path)
            actions.append({
                "component": comp,
                "status": "backed_up_and_linked",
                "message": f"Existing directory backed up and linked",
                "source": src_path,
                "dest": dest_path,
                "backup": backup_path,
            })
        else:
            # Does not exist: fresh install
            if not is_dry_run:
                os.makedirs(dest_root, exist_ok=True)
                os.symlink(src_path, dest_path)
            actions.append({
                "component": comp,
                "status": "linked",
                "message": "Symlink created",
                "source": src_path,
                "dest": dest_path,
                "backup": None,
            })

    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "dry_run": is_dry_run,
            "destination": dest_root,
            "timestamp": timestamp,
            "actions": actions,
        }
        print(json.dumps(output, indent=2))
        return 0

    # Human-readable output
    title_suffix = " (DRY RUN SIMULATION)" if is_dry_run else ""
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│               Obsyx Desktop Safe Installer{title_suffix[:15]:<15}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    if is_dry_run:
        print(yellow(bold("⚡ DRY RUN: No modifications were made to the filesystem.\n")))
    print(f"Target Destination: {bold(dest_root)}\n")

    for act in actions:
        c_name = act["component"]
        c_status = act["status"]
        if c_status == "linked":
            badge = green("✔ LINKED   ")
        elif c_status == "already_linked":
            badge = cyan("○ ALREADY LINKED")
        elif c_status == "backed_up_and_linked":
            badge = yellow("▲ BACKUP+LINK   ")
        else:
            badge = red("✘ ERROR         ")

        print(f"  {badge:<18} {bold(c_name):<12} {act['dest']}")
        if act["backup"]:
            print(f"                     {dim('Backup created at: ' + act['backup'])}")

    print()
    if is_dry_run:
        print(bold(yellow("Simulation complete. Run without --dry-run to apply changes.")))
    else:
        print(bold(green("✔ Installation complete! All selected components are safely linked.")))

        if applied_theme:
            themes = load_themes(repo_root)
            if applied_theme in themes:
                sys.path.insert(0, os.path.join(repo_root, "tools"))
                import build_tokens
                theme_data = themes[applied_theme]
                theme_marker = os.path.join(dest_root, "obsyx", "theme")
                os.makedirs(os.path.dirname(theme_marker), exist_ok=True)
                with open(theme_marker, "w", encoding="utf-8") as f:
                    f.write(f"{applied_theme}\n")

                state_file = os.path.join(dest_root, ".obsyx_theme")
                with open(state_file, "w", encoding="utf-8") as f:
                    json.dump({"active_theme": applied_theme, "name": theme_data.get("name")}, f, indent=2)

                lua_out = os.path.join(dest_root, "hypr", "themes", f"{applied_theme}.lua") if "hypr" in selected_keys else None
                css_out = os.path.join(dest_root, "waybar", "generated", "theme-tokens.css") if "waybar" in selected_keys else None
                rofi_out = os.path.join(dest_root, "rofi", "generated", "theme-tokens.rasi") if "rofi" in selected_keys else None
                swaync_out = os.path.join(dest_root, "swaync", "generated", "theme-tokens.css") if "swaync" in selected_keys else None
                hypr_conf_out = os.path.join(dest_root, "hypr", "generated", "theme-tokens.conf") if "hypr" in selected_keys else None
                kitty_out = os.path.join(dest_root, "kitty", "generated", "theme-tokens.conf") if "kitty" in selected_keys else None
                wlogout_out = os.path.join(dest_root, "wlogout", "generated", "theme-tokens.css") if "wlogout" in selected_keys else None

                build_tokens.compile_theme_artifacts(
                    theme_data,
                    lua_out=lua_out,
                    css_out=css_out,
                    rofi_out=rofi_out,
                    swaync_out=swaync_out,
                    hypr_conf_out=hypr_conf_out,
                    kitty_out=kitty_out,
                    wlogout_out=wlogout_out,
                )

        if applied_profile:
            profiles = load_profiles(repo_root)
            if applied_profile in profiles:
                prof_ns = argparse.Namespace(name=applied_profile, dest=dest_root, dry_run=False, json=False)
                run_profile_apply(prof_ns, repo_root, dest_root, profiles)

        if getattr(args, "interactive", False):
            print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
            print(bold(cyan("│                  Next Steps & Quick Start                │")))
            print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
            print(f"  1. Start your Wayland compositor session: {bold('Hyprland')}")
            print(f"  2. Switch themes anytime:                 {bold('obsyx theme list')} / {bold('obsyx theme apply <name>')}")
            print(f"  3. Switch hardware profiles anytime:      {bold('obsyx profile list')} / {bold('obsyx profile apply <name>')}")
            print(f"  4. Search keybindings cheatsheet:         {bold('obsyx docgen')} (or press Super+F1 in session)")
            print()

    print()
    return 0


# ---------------------------------------------------------------------------
# Keybinding Parser & Documentation Generator (docgen)
# ---------------------------------------------------------------------------

LUA_DOCGEN_EXTRACTOR = r"""
package.path = "./hypr/?.lua;./hypr/?/init.lua;" .. package.path

local function make_mock(name)
    name = name or "dsp"
    local t = {}
    local mt = {
        __index = function(self, key)
            local sub = make_mock(name .. "." .. tostring(key))
            rawset(self, key, sub)
            return sub
        end,
        __call = function(self, ...)
            local args = {...}
            local arg_strs = {}
            for i, a in ipairs(args) do
                if type(a) == "table" then
                    local parts = {}
                    for k, v in pairs(a) do table.insert(parts, tostring(k) .. "=" .. tostring(v)) end
                    table.insert(arg_strs, "{" .. table.concat(parts, ", ") .. "}")
                else
                    table.insert(arg_strs, tostring(a))
                end
            end
            if name == "dsp.exec_cmd" and #args > 0 then
                return tostring(args[1])
            end
            return name .. "(" .. table.concat(arg_strs, ", ") .. ")"
        end,
        __tostring = function(self) return name end
    }
    setmetatable(t, mt)
    return t
end

local all_binds = {}
local current_cat = "General"
local current_file = ""

_G.hl = {
    bind = function(key, action, opts)
        opts = opts or {}
        local act_str = tostring(action)
        local desc = opts.description
        if not desc or desc == "" then
            desc = act_str
        end
        table.insert(all_binds, {
            key = tostring(key),
            description = tostring(desc),
            action = act_str,
            category = current_cat,
            source_file = current_file,
            locked = opts.locked == true,
            repeating = opts.repeating == true,
            mouse = opts.mouse == true,
        })
    end,
    dsp = make_mock("dsp")
}

require("config.variables")

local modules = {
    { mod = "config.binds.apps", cat = "Applications & Launchers", file = "hypr/config/binds/apps.lua" },
    { mod = "config.binds.windows", cat = "Window Management", file = "hypr/config/binds/windows.lua" },
    { mod = "config.binds.workspaces", cat = "Workspace Navigation", file = "hypr/config/binds/workspaces.lua" },
    { mod = "config.binds.screenshots", cat = "Screenshots", file = "hypr/config/binds/screenshots.lua" },
    { mod = "config.binds.media", cat = "Media & Hardware Controls", file = "hypr/config/binds/media.lua" },
    { mod = "config.binds.system", cat = "System & Session Controls", file = "hypr/config/binds/system.lua" },
}

for _, m in ipairs(modules) do
    current_cat = m.cat
    current_file = m.file
    local ok, err = pcall(require, m.mod)
    if not ok then
        io.stderr:write("Error loading " .. m.mod .. ": " .. tostring(err) .. "\n")
    end
end

local function jstr(s)
    s = tostring(s or "")
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r")
    return "\"" .. s .. "\""
end

local items = {}
for _, b in ipairs(all_binds) do
    local obj = string.format(
        "{\"key\": %s, \"description\": %s, \"action\": %s, \"category\": %s, \"source_file\": %s, \"locked\": %s, \"repeating\": %s, \"mouse\": %s}",
        jstr(b.key), jstr(b.description), jstr(b.action), jstr(b.category), jstr(b.source_file),
        tostring(b.locked), tostring(b.repeating), tostring(b.mouse)
    )
    table.insert(items, obj)
end

print("{\"total\": " .. #items .. ", \"binds\": [" .. table.concat(items, ",") .. "]}")
"""


def extract_keybindings(repo_root: str) -> list:
    """Extract all active keybindings from Hyprland Lua configuration."""
    if shutil.which("lua"):
        try:
            proc = subprocess.run(
                ["lua", "-e", LUA_DOCGEN_EXTRACTOR],
                capture_output=True,
                text=True,
                cwd=repo_root,
                timeout=5,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                data = json.loads(proc.stdout)
                if "binds" in data and len(data["binds"]) > 0:
                    return data["binds"]
        except Exception:
            pass

    # Static fallback if lua runtime is not available
    binds = []
    binds_dir = os.path.join(repo_root, "hypr", "config", "binds")
    if not os.path.exists(binds_dir):
        return binds

    apps_file = os.path.join(binds_dir, "apps.lua")
    if os.path.exists(apps_file):
        with open(apps_file, "r", encoding="utf-8") as f:
            content = f.read()
        for match in re.finditer(r'\{\s*"([^"]+)"\s*,\s*([^,\s]+)\s*(?:,\s*"([^"]+)")?\s*\}', content):
            key = f"SUPER + {match.group(1)}"
            cmd = match.group(2)
            desc = match.group(3) or cmd
            binds.append({
                "key": key,
                "description": desc,
                "action": cmd,
                "category": "Applications & Launchers",
                "source_file": "hypr/config/binds/apps.lua",
                "locked": False,
                "repeating": False,
                "mouse": False,
            })

    return binds


def generate_markdown(binds: list) -> str:
    """Generate GFM markdown cheatsheet for keybindings."""
    lines = [
        "# Obsyx Keybindings Cheatsheet",
        "",
        "> **Environment:** Hyprland + Noctis Amethyst<br/>",
        "> **Modifier Key (`MOD`):** `SUPER` (Windows / Command key)<br/>",
        "> **Source Configurations:** `hypr/config/binds/*.lua` and `hypr/config/variables.lua`<br/>",
        "> *Note: Automatically generated by `obsyx docgen`.*",
        "",
        "---",
        "",
        "## Categories Overview",
        "",
        "| Category | Shortcuts | Description |",
        "| :--- | :---: | :--- |",
    ]

    cats = {}
    cat_order = [
        "Applications & Launchers",
        "Window Management",
        "Workspace Navigation",
        "Screenshots",
        "Media & Hardware Controls",
        "System & Session Controls",
    ]
    for b in binds:
        cat = b.get("category", "General")
        cats.setdefault(cat, []).append(b)

    cat_descs = {
        "Applications & Launchers": "Core applications, terminal, browser, and desktop launcher",
        "Window Management": "Window tiling, floating, fullscreen, layout split, focus, and drag/resize",
        "Workspace Navigation": "Workspaces 1-10, scratchpads, and active window movement",
        "Screenshots": "Screen, window, and region captures via hyprshot",
        "Media & Hardware Controls": "Audio volume, microphone mute, monitor brightness, and media playback",
        "System & Session Controls": "Session lock, power menu, logout, suspend, reboot, and power off",
    }

    for cat in cat_order:
        if cat in cats:
            count = len(cats[cat])
            desc = cat_descs.get(cat, "")
            slug = cat.lower().replace(" & ", "-").replace(" ", "-")
            lines.append(f"| [{cat}](#{slug}) | {count} | {desc} |")

    lines.append("")
    lines.append("---")
    lines.append("")

    def format_key_kbd(key_str: str) -> str:
        parts = [p.strip() for p in key_str.split("+")]
        return " + ".join(f"<kbd>{p}</kbd>" for p in parts)

    for cat in cat_order:
        if cat not in cats:
            continue
        c_binds = cats[cat]
        lines.append(f"## {cat}")
        lines.append("")
        lines.append("| Shortcut | Description | Action / Command |")
        lines.append("| :--- | :--- | :--- |")
        for b in c_binds:
            kbd_str = format_key_kbd(b["key"])
            desc = b.get("description", "").replace("|", "\\|")
            act = b.get("action", "").replace("|", "\\|")
            lines.append(f"| {kbd_str} | {desc} | `{act}` |")
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def generate_rofi_script(binds: list) -> str:
    """Generate interactive Rofi keybinding search script."""
    entries_code = []
    actions_code = []

    for b in binds:
        key = b["key"]
        desc = b.get("description", "")
        cat = b.get("category", "")
        act = b.get("action", "")

        entry_line = f"{key:<26} │ {desc:<28} │ {cat}"
        escaped_entry = entry_line.replace('"', '\\"')
        escaped_action = act.replace('"', '\\"')

        entries_code.append(f'    "{escaped_entry}"')
        actions_code.append(f'    "{escaped_action}"')

    entries_block = "\n".join(entries_code)
    actions_block = "\n".join(actions_code)

    script = f"""#!/usr/bin/env bash
# Obsyx - Interactive Keybinding Search & Launcher
# Search all configured shortcuts and optionally execute their action.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${{BASH_SOURCE[0]}}")" && pwd)"
ROFI_DIR="$(cd "${{SCRIPT_DIR}}/.." && pwd)"
THEME="${{ROFI_DIR}}/app-launcher.rasi"

if ! command -v rofi >/dev/null 2>&1; then
    echo "Error: rofi is not installed or not in PATH" >&2
    exit 1
fi

ROFI_ARGS=(-i -p "Shortcuts" -format i)
if [[ -f "${{THEME}}" ]]; then
    ROFI_ARGS+=(-theme "${{THEME}}")
fi

declare -a ENTRIES=(
{entries_block}
)

declare -a ACTIONS=(
{actions_block}
)

# Render menu and capture selection index
INDEX="$(printf "%s\\n" "${{ENTRIES[@]}}" | rofi -dmenu "${{ROFI_ARGS[@]}}" || true)"

if [[ -z "${{INDEX}}" ]]; then
    exit 0
fi

ACTION="${{ACTIONS[INDEX]:-}}"
if [[ -z "${{ACTION}}" ]]; then
    exit 0
fi

# Dispatch or execute action
if [[ "${{ACTION}}" == dsp.* ]]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Obsyx Keybinding" "${{ENTRIES[INDEX]}}"
    fi
else
    # Shell command execution
    eval "${{ACTION}} &"
fi
"""
    return script.strip() + "\n"


def run_docgen(args) -> int:
    """Run docgen subcommand."""
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    binds = extract_keybindings(repo_root)

    if getattr(args, "json", False):
        cats = sorted(list({b["category"] for b in binds}))
        output = {
            "status": "ok",
            "total": len(binds),
            "categories": cats,
            "keybindings": binds,
        }
        print(json.dumps(output, indent=2))
        return 0

    target_md = getattr(args, "output", None) or os.path.join(repo_root, "KEYBINDINGS.md")
    target_rofi = getattr(args, "rofi_script", None) or os.path.join(repo_root, "rofi", "scripts", "keybindings.sh")

    new_md_content = generate_markdown(binds)
    new_rofi_content = generate_rofi_script(binds)

    is_check = getattr(args, "check", False)

    if is_check:
        mismatched = []
        if not os.path.exists(target_md):
            mismatched.append(f"Missing {target_md}")
        else:
            with open(target_md, "r", encoding="utf-8") as f:
                if f.read() != new_md_content:
                    mismatched.append(f"Outdated {target_md}")

        if not os.path.exists(target_rofi):
            mismatched.append(f"Missing {target_rofi}")
        else:
            with open(target_rofi, "r", encoding="utf-8") as f:
                if f.read() != new_rofi_content:
                    mismatched.append(f"Outdated {target_rofi}")

        if mismatched:
            print(red(f"✘ Documentation check failed: {', '.join(mismatched)}"))
            return 1
        print(green("✔ Documentation check passed: All cheatsheets are up to date."))
        return 0

    # Write output files
    os.makedirs(os.path.dirname(os.path.abspath(target_md)), exist_ok=True)
    with open(target_md, "w", encoding="utf-8") as f:
        f.write(new_md_content)

    os.makedirs(os.path.dirname(os.path.abspath(target_rofi)), exist_ok=True)
    with open(target_rofi, "w", encoding="utf-8") as f:
        f.write(new_rofi_content)
    os.chmod(target_rofi, 0o755)

    num_cats = len({b["category"] for b in binds})
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│           Obsyx Keybinding Cheatsheet Generator          │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Extracted {bold(str(len(binds)))} keybindings across {bold(str(num_cats))} categories.\n")
    print(f"  {green('✔ GENERATED')} {bold('KEYBINDINGS.md')}       -> {target_md}")
    print(f"  {green('✔ GENERATED')} {bold('keybindings.sh')}        -> {target_rofi}")
    print()

    return 0


# ---------------------------------------------------------------------------
# Desktop Variants & Hardware Profiles (obsyx profile)
# ---------------------------------------------------------------------------

def load_profiles(repo_root: str) -> dict:
    """Load metadata for all available profiles in profiles/ directory."""
    profiles_dir = os.path.join(repo_root, "profiles")
    if not os.path.exists(profiles_dir):
        return {}

    profiles = {}
    for entry in sorted(os.listdir(profiles_dir)):
        p_dir = os.path.join(profiles_dir, entry)
        if not os.path.isdir(p_dir):
            continue
        meta_file = os.path.join(p_dir, "profile.json")
        if os.path.isfile(meta_file):
            try:
                with open(meta_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    profiles[data.get("name", entry)] = data
            except Exception:
                pass
    return profiles


def get_active_profile(dest_root: str) -> str | None:
    """Read currently active profile from destination directory."""
    state_file = os.path.join(dest_root, ".obsyx_profile")
    if os.path.isfile(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("active_profile")
        except Exception:
            pass
    return None


def run_profile_list(args, repo_root: str, dest_root: str, profiles: dict) -> int:
    """List available profiles."""
    active = get_active_profile(dest_root)
    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "active_profile": active,
            "destination": dest_root,
            "profiles": list(profiles.values()),
        }
        print(json.dumps(output, indent=2))
        return 0

    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│              Obsyx Desktop Hardware Profiles             │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Target Destination: {bold(dest_root)}")
    if active:
        print(f"Active Profile:     {bold(green(active))}\n")
    else:
        print(f"Active Profile:     {dim('default (none applied)')}\n")

    for p_name, p_data in sorted(profiles.items()):
        is_act = (p_name == active)
        badge = green("● ACTIVE") if is_act else dim("○")
        print(f"  {badge:<12} {bold(p_name):<14} {p_data.get('display_name', '')}")
        print(f"               {dim(p_data.get('description', ''))}")
        feat_strs = []
        for k, v in p_data.get("features", {}).items():
            feat_strs.append(f"{k}: {v}")
        if feat_strs:
            print(f"               {dim('Features: ' + ', '.join(feat_strs))}")
        print()

    return 0


def run_profile_show(args, repo_root: str, dest_root: str, profiles: dict) -> int:
    """Show details for a specific profile."""
    name = getattr(args, "name", None)
    if not name or name not in profiles:
        avail = ", ".join(sorted(profiles.keys()))
        print(red(f"Error: Unknown profile '{name}'. Available: {avail}"), file=sys.stderr)
        return 1

    data = profiles[name]
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
        return 0

    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│ Profile: {data.get('display_name', name)[:47]:<47}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Name:        {bold(data.get('name', ''))}")
    print(f"Form Factor: {bold(data.get('form_factor', ''))}")
    print(f"Description: {data.get('description', '')}\n")
    print(bold("Features & Tuning:"))
    for k, v in data.get("features", {}).items():
        val_str = green("yes") if v is True else (red("no") if v is False else bold(str(v)))
        print(f"  • {k:<26} {val_str}")
    print()
    return 0


def run_profile_apply(args, repo_root: str, dest_root: str, profiles: dict) -> int:
    """Apply a hardware profile to target configuration."""
    name = getattr(args, "name", None)
    if not name or name not in profiles:
        avail = ", ".join(sorted(profiles.keys()))
        print(red(f"Error: Unknown profile '{name}'. Available: {avail}"), file=sys.stderr)
        return 1

    is_dry_run = getattr(args, "dry_run", False)
    profile_dir = os.path.join(repo_root, "profiles", name)
    p_meta = profiles[name]

    hypr_src = os.path.join(profile_dir, "hypr", "profile.lua")
    hypr_dest = os.path.join(dest_root, "hypr", "config", "profile.lua")
    obsyx_profile_lua = os.path.join(dest_root, "obsyx", "profile.lua")

    waybar_conf_src = os.path.join(profile_dir, "waybar", "config.jsonc")
    waybar_conf_dest = os.path.join(dest_root, "waybar", "config.jsonc")

    waybar_style_src = os.path.join(profile_dir, "waybar", "style.css")
    waybar_style_dest = os.path.join(dest_root, "waybar", "profile-style.css")

    state_dest = os.path.join(dest_root, ".obsyx_profile")

    actions = [
        {"target": hypr_dest, "source": hypr_src, "description": "Hyprland profile override"},
        {"target": obsyx_profile_lua, "source": hypr_src, "description": "Obsyx XDG profile override"},
        {"target": waybar_conf_dest, "source": waybar_conf_src, "description": "Waybar profile layout"},
        {"target": waybar_style_dest, "source": waybar_style_src, "description": "Waybar profile stylesheet"},
    ]

    if not is_dry_run:
        # If dest_root/waybar is a symlink directly pointing to the repository waybar dir,
        # convert it into a directory of symlinks so profile overrides do not modify the repository.
        dest_waybar = os.path.join(dest_root, "waybar")
        repo_waybar = os.path.join(repo_root, "waybar")
        if os.path.islink(dest_waybar) and os.path.realpath(dest_waybar) == os.path.realpath(repo_waybar):
            os.unlink(dest_waybar)
            os.makedirs(dest_waybar, exist_ok=True)
            for item in os.listdir(repo_waybar):
                os.symlink(os.path.join(repo_waybar, item), os.path.join(dest_waybar, item))

        # Similarly for dest_root/hypr
        dest_hypr = os.path.join(dest_root, "hypr")
        repo_hypr = os.path.join(repo_root, "hypr")
        if os.path.islink(dest_hypr) and os.path.realpath(dest_hypr) == os.path.realpath(repo_hypr):
            os.unlink(dest_hypr)
            os.makedirs(dest_hypr, exist_ok=True)
            for item in os.listdir(repo_hypr):
                os.symlink(os.path.join(repo_hypr, item), os.path.join(dest_hypr, item))

        dest_config = os.path.join(dest_hypr, "config")
        repo_config = os.path.join(repo_hypr, "config")
        if os.path.islink(dest_config) and os.path.realpath(dest_config) == os.path.realpath(repo_config):
            os.unlink(dest_config)
            os.makedirs(dest_config, exist_ok=True)
            for item in os.listdir(repo_config):
                os.symlink(os.path.join(repo_config, item), os.path.join(dest_config, item))

        os.makedirs(os.path.dirname(hypr_dest), exist_ok=True)
        os.makedirs(os.path.dirname(obsyx_profile_lua), exist_ok=True)
        os.makedirs(os.path.dirname(waybar_conf_dest), exist_ok=True)

        if os.path.islink(hypr_dest):
            os.unlink(hypr_dest)
        shutil.copy2(hypr_src, hypr_dest)
        shutil.copy2(hypr_src, obsyx_profile_lua)

        if os.path.islink(waybar_conf_dest):
            os.unlink(waybar_conf_dest)
        elif os.path.isfile(waybar_conf_dest):
            bak = f"{waybar_conf_dest}.bak"
            if not os.path.exists(bak):
                shutil.copy2(waybar_conf_dest, bak)

        shutil.copy2(waybar_conf_src, waybar_conf_dest)

        if os.path.islink(waybar_style_dest):
            os.unlink(waybar_style_dest)
        shutil.copy2(waybar_style_src, waybar_style_dest)


        state_data = {
            "active_profile": name,
            "applied_at": datetime.now().isoformat(),
            "features": p_meta.get("features", {}),
        }
        with open(state_dest, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=2)

        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            try:
                subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=2)
            except Exception:
                pass
        if shutil.which("pkill"):
            try:
                subprocess.run(["pkill", "-SIGUSR2", "waybar"], capture_output=True, timeout=2)
            except Exception:
                pass

    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "profile": name,
            "dry_run": is_dry_run,
            "destination": dest_root,
            "actions": actions,
        }
        print(json.dumps(output, indent=2))
        return 0

    title_suffix = " (DRY RUN SIMULATION)" if is_dry_run else ""
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│           Obsyx Profile Switcher{title_suffix[:21]:<21}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    if is_dry_run:
        print(yellow(bold("⚡ DRY RUN: No modifications were made to the filesystem.\n")))

    print(f"Target Destination: {bold(dest_root)}")
    print(f"Applying Profile:   {bold(green(p_meta.get('display_name', name)))}\n")

    for act in actions:
        status_badge = yellow("○ SIMULATE") if is_dry_run else green("✔ APPLIED ")
        print(f"  {status_badge} {bold(act['description']):<28} {act['target']}")

    print()
    if is_dry_run:
        print(bold(yellow("Simulation complete. Run without --dry-run to apply changes.")))
    else:
        print(bold(green(f"✔ Successfully applied '{name}' profile! Desktop is tuned for {p_meta.get('form_factor', 'hardware')}.")))
    print()
    return 0


def run_profile(args) -> int:
    """Run profile subcommand."""
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    dest_root = os.path.abspath(getattr(args, "dest", None) or os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"))
    profiles = load_profiles(repo_root)

    action = getattr(args, "profile_action", None)
    if action == "show":
        return run_profile_show(args, repo_root, dest_root, profiles)
    elif action == "apply":
        return run_profile_apply(args, repo_root, dest_root, profiles)
    else:
        return run_profile_list(args, repo_root, dest_root, profiles)


# ---------------------------------------------------------------------------
# Theme Management Framework
# ---------------------------------------------------------------------------

THEME_DESCRIPTIONS = {
    "noctis_amethyst": "Regal nocturnal purple & soft lavender glass (Reference Theme)",
    "obsidian":        "Monolithic dark stone, matte graphite & cool platinum accents",
    "frost":           "Crystalline polar slate & ice-blue sub-zero clarity",
    "aurora":          "Midnight oceanic teal, emerald luminescence & Arctic sky",
    "ember":           "Volcanic basalt rock, glowing embers & warm magma copper",
}


def load_themes(repo_root: str) -> dict:
    """Load canonical theme definitions from core/tokens/ directory."""
    tokens_dir = os.path.join(repo_root, "core", "tokens")
    if not os.path.exists(tokens_dir):
        return {}

    sys.path.insert(0, os.path.join(repo_root, "tools"))
    import build_tokens

    themes = {}
    for entry in sorted(os.listdir(tokens_dir)):
        if not entry.endswith(".json"):
            continue
        token_path = os.path.join(tokens_dir, entry)
        try:
            data = build_tokens.load_and_resolve_theme(token_path)
            slug = data.get("name", "").lower().replace(" ", "_")
            if not slug:
                slug = os.path.splitext(entry)[0]
            data["slug"] = slug
            if slug in THEME_DESCRIPTIONS:
                data["description"] = THEME_DESCRIPTIONS[slug]
            elif "description" not in data:
                data["description"] = f"Official Obsyx theme {data.get('name')}"
            themes[slug] = data
        except Exception:
            pass
    return themes


def get_active_theme(dest_root: str, repo_root: str) -> str:
    """Detect currently active theme slug."""
    # 1. Check <dest_root>/obsyx/theme
    theme_file = os.path.join(dest_root, "obsyx", "theme")
    if os.path.isfile(theme_file):
        try:
            with open(theme_file, "r", encoding="utf-8") as f:
                content = f.read().strip()
                if content:
                    return content.lower().replace(" ", "_")
        except Exception:
            pass

    # 2. Check <dest_root>/.obsyx_theme
    state_file = os.path.join(dest_root, ".obsyx_theme")
    if os.path.isfile(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                slug = data.get("active_theme") or data.get("slug")
                if slug:
                    return slug.lower().replace(" ", "_")
        except Exception:
            pass

    return "noctis_amethyst"


def run_theme_list(args, repo_root: str, dest_root: str, themes: dict) -> int:
    """List available themes."""
    active = get_active_theme(dest_root, repo_root)
    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "active_theme": active,
            "destination": dest_root,
            "themes": [
                {
                    "name": t.get("name"),
                    "slug": t.get("slug"),
                    "version": t.get("version", "0.1.0"),
                    "description": t.get("description", ""),
                    "is_active": (t.get("slug") == active),
                    "accent": t.get("palette", {}).get("accent"),
                    "accent_ink": t.get("palette", {}).get("accent_ink"),
                    "void": t.get("palette", {}).get("void"),
                }
                for t in themes.values()
            ],
        }
        print(json.dumps(output, indent=2))
        return 0

    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan("│                  Obsyx Official Themes                   │")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Target Destination: {bold(dest_root)}")
    print(f"Active Theme:       {bold(green(active))}\n")

    for t_slug, t_data in sorted(themes.items()):
        is_act = (t_slug == active)
        badge = green("● ACTIVE") if is_act else dim("○")
        palette = t_data.get("palette", {})
        accent = palette.get("accent", "")
        if isinstance(accent, dict):
            accent = accent.get("hex", "")
        void = palette.get("void", "")
        if isinstance(void, dict):
            void = void.get("hex", "")

        color_preview = f"accent: {accent}  void: {void}"
        print(f"  {badge:<12} {bold(t_slug):<18} {t_data.get('name', '')}")
        print(f"                 {dim(t_data.get('description', ''))}")
        print(f"                 {dim(color_preview)}")
        print()

    return 0


def run_theme_show(args, repo_root: str, dest_root: str, themes: dict) -> int:
    """Show detailed metadata and tokens for a theme."""
    name = getattr(args, "name", None)
    if not name:
        avail = ", ".join(sorted(themes.keys()))
        print(red(f"Error: Specify a theme name or slug. Available: {avail}"), file=sys.stderr)
        return 1

    slug = name.lower().replace(" ", "_")
    if slug not in themes:
        avail = ", ".join(sorted(themes.keys()))
        print(red(f"Error: Unknown theme '{name}'. Available: {avail}"), file=sys.stderr)
        return 1

    data = themes[slug]
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
        return 0

    palette = data.get("palette", {})
    geometry = data.get("geometry", {})
    blur = data.get("blur", {})
    opacity = data.get("opacity", {})
    shadow = data.get("shadow", {})

    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│ Theme: {data.get('name', slug)[:49]:<49}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    print(f"Name:        {bold(data.get('name', ''))}")
    print(f"Slug:        {bold(slug)}")
    print(f"Version:     {data.get('version', '0.1.0')}")
    print(f"Description: {data.get('description', '')}\n")

    print(bold("Key Palette Tokens:"))
    for key in ("void", "surface", "accent", "accent_ink", "warning", "danger", "border_inactive"):
        val = palette.get(key)
        if isinstance(val, dict):
            val_str = f"{val.get('hex')} (alpha {val.get('alpha')})"
        else:
            val_str = str(val)
        print(f"  • {key:<18} {bold(val_str)}")

    print(f"\n{bold('Geometry & Materials:')}")
    print(f"  • rounding:         {geometry.get('rounding', 8)}px (power {geometry.get('rounding_power', 2.0)})")
    print(f"  • gaps (in/out):    {geometry.get('gaps_in', 5)}px / {geometry.get('gaps_out', 12)}px")
    print(f"  • border size:      {geometry.get('border_size', 2)}px")
    print(f"  • blur passes/size: {blur.get('passes', 3)} passes / {blur.get('size', 13)}px (vibrancy {blur.get('vibrancy', 0.3)})")
    print(f"  • opacity (active): {opacity.get('active', 0.75)} (inactive: {opacity.get('inactive', 0.65)})")
    print()
    return 0


def run_theme_apply(args, repo_root: str, dest_root: str, themes: dict) -> int:
    """Apply an official theme to target configuration."""
    name = getattr(args, "name", None)
    if not name:
        avail = ", ".join(sorted(themes.keys()))
        print(red(f"Error: Specify a theme name or slug to apply. Available: {avail}"), file=sys.stderr)
        return 1

    slug = name.lower().replace(" ", "_")
    if slug not in themes:
        avail = ", ".join(sorted(themes.keys()))
        print(red(f"Error: Unknown theme '{name}'. Available: {avail}"), file=sys.stderr)
        return 1

    is_dry_run = getattr(args, "dry_run", False)
    theme_data = themes[slug]
    t_name = theme_data.get("name", slug)

    sys.path.insert(0, os.path.join(repo_root, "tools"))
    import build_tokens

    # Targets to generate
    theme_marker_file = os.path.join(dest_root, "obsyx", "theme")
    state_file = os.path.join(dest_root, ".obsyx_theme")
    lua_out = os.path.join(dest_root, "hypr", "themes", f"{slug}.lua")
    css_out = os.path.join(dest_root, "waybar", "generated", "theme-tokens.css")
    rofi_out = os.path.join(dest_root, "rofi", "generated", "theme-tokens.rasi")
    swaync_out = os.path.join(dest_root, "swaync", "generated", "theme-tokens.css")
    hypr_conf_out = os.path.join(dest_root, "hypr", "generated", "theme-tokens.conf")
    kitty_out = os.path.join(dest_root, "kitty", "generated", "theme-tokens.conf")
    wlogout_out = os.path.join(dest_root, "wlogout", "generated", "theme-tokens.css")

    actions = [
        {"target": theme_marker_file, "description": "Active theme marker"},
        {"target": state_file,        "description": "Theme state metadata"},
        {"target": lua_out,           "description": "Hyprland Lua theme table"},
        {"target": css_out,           "description": "Waybar CSS theme tokens"},
        {"target": rofi_out,          "description": "Rofi RASI theme tokens"},
        {"target": swaync_out,        "description": "SwayNC CSS theme tokens"},
        {"target": hypr_conf_out,     "description": "Hyprland conf theme tokens"},
        {"target": kitty_out,         "description": "Kitty conf theme tokens"},
        {"target": wlogout_out,       "description": "Wlogout CSS theme tokens"},
    ]

    if not is_dry_run:
        # Create directories and write files
        os.makedirs(os.path.dirname(theme_marker_file), exist_ok=True)
        with open(theme_marker_file, "w", encoding="utf-8") as f:
            f.write(f"{slug}\n")

        state_data = {
            "active_theme": slug,
            "name": t_name,
            "version": theme_data.get("version", "0.1.0"),
            "applied_at": datetime.now().isoformat(),
            "palette": {
                "accent": theme_data.get("palette", {}).get("accent"),
                "void": theme_data.get("palette", {}).get("void"),
            },
        }
        with open(state_file, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=2)

        build_tokens.compile_theme_artifacts(
            theme_data,
            lua_out=lua_out,
            css_out=css_out,
            rofi_out=rofi_out,
            swaync_out=swaync_out,
            hypr_conf_out=hypr_conf_out,
            kitty_out=kitty_out,
            wlogout_out=wlogout_out,
        )

        # Dispatch compositor reload signals if running
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            try:
                subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=2)
            except Exception:
                pass
        if shutil.which("pkill"):
            try:
                subprocess.run(["pkill", "-SIGUSR2", "waybar"], capture_output=True, timeout=2)
            except Exception:
                pass
        if shutil.which("swaync-client"):
            try:
                subprocess.run(["swaync-client", "-R"], capture_output=True, timeout=2)
            except Exception:
                pass

    if getattr(args, "json", False):
        output = {
            "status": "ok",
            "theme": slug,
            "name": t_name,
            "dry_run": is_dry_run,
            "destination": dest_root,
            "actions": actions,
        }
        print(json.dumps(output, indent=2))
        return 0

    title_suffix = " (DRY RUN SIMULATION)" if is_dry_run else ""
    print(bold(cyan("\n╭──────────────────────────────────────────────────────────╮")))
    print(bold(cyan(f"│            Obsyx Theme Switcher{title_suffix[:23]:<23}│")))
    print(bold(cyan("╰──────────────────────────────────────────────────────────╯\n")))
    if is_dry_run:
        print(yellow(bold("⚡ DRY RUN: No modifications were made to the filesystem.\n")))

    print(f"Target Destination: {bold(dest_root)}")
    print(f"Applying Theme:     {bold(green(t_name))} ({slug})\n")

    for act in actions:
        status_badge = yellow("○ SIMULATE") if is_dry_run else green("✔ COMPILED")
        print(f"  {status_badge} {bold(act['description']):<28} {act['target']}")

    print()
    if is_dry_run:
        print(bold(yellow("Simulation complete. Run without --dry-run to apply changes.")))
    else:
        print(bold(green(f"✔ Successfully applied '{t_name}'! Live compositor components reloaded.")))
    print()
    return 0


def run_theme_rofi(args, repo_root: str) -> int:
    """Launch the interactive Rofi theme switcher."""
    switcher_script = os.path.join(repo_root, "rofi", "scripts", "theme-switcher.sh")
    if not os.path.isfile(switcher_script):
        print(red(f"Error: Switcher script not found at {switcher_script}"), file=sys.stderr)
        return 1

    if not shutil.which("rofi"):
        print(red("Error: 'rofi' executable not found in PATH."), file=sys.stderr)
        return 1

    proc = subprocess.run(["bash", switcher_script])
    return proc.returncode


def run_theme(args) -> int:
    """Run theme subcommand."""
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    dest_root = os.path.abspath(getattr(args, "dest", None) or os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"))
    themes = load_themes(repo_root)

    action = getattr(args, "theme_action", None)
    if action == "show":
        return run_theme_show(args, repo_root, dest_root, themes)
    elif action == "apply":
        return run_theme_apply(args, repo_root, dest_root, themes)
    elif action == "rofi":
        return run_theme_rofi(args, repo_root)
    else:
        return run_theme_list(args, repo_root, dest_root, themes)


# ---------------------------------------------------------------------------
# Main CLI Entrypoint
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="obsyx",
        description="Obsyx — Modular Hyprland desktop environment framework CLI.",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"Obsyx v{VERSION}",
        help="Show Obsyx version.",
    )

    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # Doctor
    doc_parser = subparsers.add_parser("doctor", help="Check system dependencies and desktop runtime tooling.")
    doc_parser.add_argument("--json", action="store_true", help="Output diagnostic report as JSON.")
    doc_parser.add_argument("--verbose", "-v", action="store_true", help="Enable verbose diagnostics.")

    # Validate
    val_parser = subparsers.add_parser("validate", help="Validate Lua, JSONC, Shell scripts, and design tokens.")
    val_parser.add_argument("--path", "-p", help="Target configuration directory to validate (default: current directory).")
    val_parser.add_argument("--json", action="store_true", help="Output validation results as JSON.")
    val_parser.add_argument("--verbose", "-v", action="store_true", help="Enable verbose validation output.")

    # Install
    ins_parser = subparsers.add_parser("install", help="Safely install Obsyx desktop configuration with backups and dry-run.")
    ins_parser.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    ins_parser.add_argument("--dry-run", action="store_true", help="Simulate installation without touching the filesystem.")
    ins_parser.add_argument("--components", "-c", help="Comma-separated components to install (e.g. hypr,waybar,kitty).")
    ins_parser.add_argument("--skip", "-s", help="Comma-separated components to skip.")
    ins_parser.add_argument("--interactive", "-i", action="store_true", help="Launch interactive guided installation wizard.")
    ins_parser.add_argument("--json", action="store_true", help="Output installation plan/result as JSON.")

    # Docgen
    docgen_parser = subparsers.add_parser("docgen", help="Generate keybindings cheatsheet (KEYBINDINGS.md) and Rofi search script.")
    docgen_parser.add_argument("--output", "-o", help="Target markdown cheatsheet output path (default: KEYBINDINGS.md).")
    docgen_parser.add_argument("--rofi-script", "-r", help="Target Rofi search script output path (default: rofi/scripts/keybindings.sh).")
    docgen_parser.add_argument("--check", action="store_true", help="Check whether generated files are up to date without writing.")
    docgen_parser.add_argument("--json", action="store_true", help="Output keybindings data as JSON.")

    # Profile
    prof_parser = subparsers.add_parser("profile", help="Manage desktop hardware profiles (laptop, workstation).")
    prof_parser.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    prof_parser.add_argument("--json", action="store_true", help="Output profile list as JSON.")

    prof_subparsers = prof_parser.add_subparsers(dest="profile_action", help="Profile actions (list, show, apply).")

    # profile list
    p_list = prof_subparsers.add_parser("list", help="List available desktop profiles.")
    p_list.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    p_list.add_argument("--json", action="store_true", help="Output profile list as JSON.")

    # profile show
    p_show = prof_subparsers.add_parser("show", help="Show profile details and feature matrix.")
    p_show.add_argument("name", help="Profile name (e.g. laptop, workstation).")
    p_show.add_argument("--json", action="store_true", help="Output profile details as JSON.")

    # profile apply
    p_apply = prof_subparsers.add_parser("apply", help="Apply a hardware profile to target configuration.")
    p_apply.add_argument("name", help="Profile name to apply (e.g. laptop, workstation).")
    p_apply.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    p_apply.add_argument("--dry-run", action="store_true", help="Simulate applying profile without touching filesystem.")
    p_apply.add_argument("--json", action="store_true", help="Output apply report as JSON.")

    # Theme
    theme_parser = subparsers.add_parser("theme", help="Manage and switch desktop themes (Noctis Amethyst, Obsidian, Frost, Aurora, Ember).")
    theme_parser.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    theme_parser.add_argument("--json", action="store_true", help="Output theme list as JSON.")

    theme_subparsers = theme_parser.add_subparsers(dest="theme_action", help="Theme actions (list, show, apply, rofi).")

    # theme list
    t_list = theme_subparsers.add_parser("list", help="List available official themes.")
    t_list.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    t_list.add_argument("--json", action="store_true", help="Output theme list as JSON.")

    # theme show
    t_show = theme_subparsers.add_parser("show", help="Show theme tokens and material properties.")
    t_show.add_argument("name", help="Theme name or slug (e.g. obsidian, frost, aurora, ember, noctis_amethyst).")
    t_show.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    t_show.add_argument("--json", action="store_true", help="Output theme details as JSON.")

    # theme apply
    t_apply = theme_subparsers.add_parser("apply", help="Apply an official theme to target desktop configuration.")
    t_apply.add_argument("name", help="Theme name or slug to apply.")
    t_apply.add_argument("--dest", "--target", dest="dest", help="Target configuration destination (default: ~/.config).")
    t_apply.add_argument("--dry-run", action="store_true", help="Simulate applying theme without touching filesystem.")
    t_apply.add_argument("--json", action="store_true", help="Output apply report as JSON.")

    # theme rofi
    t_rofi = theme_subparsers.add_parser("rofi", help="Launch the interactive Rofi theme switcher.")

    args = parser.parse_args()

    if args.command == "doctor":
        sys.exit(run_doctor(args))
    elif args.command == "validate":
        sys.exit(run_validate(args))
    elif args.command == "install":
        sys.exit(run_install(args))
    elif args.command == "docgen":
        sys.exit(run_docgen(args))
    elif args.command == "profile":
        sys.exit(run_profile(args))
    elif args.command == "theme":
        sys.exit(run_theme(args))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
